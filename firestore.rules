rules_version = '2';

// =============================================================
// Firestore 보안 규칙 — class-book-worksheets (책 나눔)
// -------------------------------------------------------------
// 원칙
//  · 로그인하지 않으면 아무것도 못 읽고/못 씀 (기본 거부)
//  · 질문 게시판(questions·answers·notices·keywords)은 전체 공유
//  · 공부방(반)의 모든 자산(보드·카드·과일·누가기록·KWL·입장코드)은
//    그 반을 개설한 교사(classes.createdBy)에게 귀속.
//    최고 관리자(users 문서의 role == 'admin')만 전체 접근.
//  · 역할(role)은 users/{uid}.role 한 칸 — 스스로 바꿀 수 있는 길은 하나뿐:
//    배포한 사람이 콘솔에 적어 둔 **교사 가입 코드**(config/teacherSignup)를
//    맞게 넣어 학생 → 선생님. 그 밖의 역할 변경은 관리자만.
//    (서버 함수 · 커스텀 클레임 없이 돕니다 — 비전공자도 배포하게)
//  · 반이 '보관(archived)' 상태면: 소유 교사도 그 반의 데이터는 읽기만
//    가능(쓰기 전면 차단, 보관 해제해야 편집 가능) / 학생은 읽기도 불가.
//    classes 문서 자체(이름 수정·보관 토글)는 예외 — 항상 소유 교사가 수정 가능.
// 배포:  firebase deploy --only firestore:rules
// =============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    // 역할 — users/{uid}.role. 서버 함수가 없어 커스텀 클레임을 줄 길이 없으므로
    // 프로필 문서를 읽어 판정합니다(같은 요청 안에서는 한 번만 읽힘).
    // 토큰에 role 클레임이 있으면 그것을 먼저 봅니다 — 예전 배포 · 시험용이고,
    // 클레임은 admin SDK만 줄 수 있어 위조할 수 없습니다.
    function userRole() {
      return request.auth.token.get('role', '') != ''
        ? request.auth.token.role
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'student')
            : 'student');
    }

    // 교사 가입 코드 — 배포한 사람이 Firebase 콘솔에서 config/teacherSignup
    // 문서의 code 칸에 적어 둡니다. 이 컬렉션에는 match가 없어 **앱에서는
    // 아무도 읽지 못하고**, 규칙의 get()만 대조합니다. 문서가 없거나 너무
    // 짧으면 아무도 선생님이 될 수 없습니다(안전한 쪽).
    function teacherCodeOk(code) {
      return code is string && code.size() >= 4
        && exists(/databases/$(database)/documents/config/teacherSignup)
        && get(/databases/$(database)/documents/config/teacherSignup).data.get('code', '') is string
        && get(/databases/$(database)/documents/config/teacherSignup).data.get('code', '').size() >= 4
        && get(/databases/$(database)/documents/config/teacherSignup).data.get('code', '') == code;
    }

    // 최고 관리자 — users 문서의 role이 'admin'. 이메일을 규칙에 박아 두지
    // 않습니다(공개 운영). 첫 관리자는 배포한 사람이 콘솔에서 제 users 문서의
    // role을 'admin'으로 고쳐 지정합니다(앱에서는 스스로 못 올림).
    // 모든 반의 데이터·기능에 접근(반 소유 제한의 예외).
    function isAdmin() {
      return signedIn() && userRole() == 'admin';
    }
    // 내가 지금 소속된 반 id 목록 — users/{uid}.classIds에 학생이 반에 들어갈
    // 때마다 스스로 이어붙입니다(공부방 급우 명단 공개 판정용, isClassmate 참고).
    function myClassIds() {
      return exists(/databases/$(database)/documents/users/$(uid()))
             ? get(/databases/$(database)/documents/users/$(uid())).data.get('classIds', [])
             : [];
    }
    // 같은 반 학생인지 — users 문서 read 규칙 전용. 내(uid()) classIds에 있는
    // 반 중 하나라도 대상(targetUid)의 memberships 문서가 있으면 급우입니다.
    // 대상 쪽은 classIds가 아니라 이미 있는 memberships로 확인하는 게 핵심 —
    // 대상이 아직 이 기능 배포 뒤 한 번도 접속 안 해 자기 classIds를 못
    // 채웠어도(자가 치유는 각자 접속할 때만 실행됨), 그 학생의 카드 자리는
    // 곧바로 보여야 하기 때문입니다.
    //
    // 이 규칙 엔진은 list에 대한 반복(.exists()/.all() 같은 CEL 매크로)을
    // 지원하지 않아(실측: "Function not found: exists"), 앞에서부터 5개
    // 반까지만 하나씩 펼쳐 확인합니다 — 학생 한 명이 이 앱에서 5개 넘는
    // 반에 동시에 속하는 경우는 없다고 봐도 됩니다(있다면 6번째부터는
    // 급우 명단에서만 안 보이고, 다른 기능엔 영향 없습니다).
    function isClassmateOf(targetUid) {
      let mine = myClassIds();
      return hasMembership(targetUid, mine, 0)
             || hasMembership(targetUid, mine, 1)
             || hasMembership(targetUid, mine, 2)
             || hasMembership(targetUid, mine, 3)
             || hasMembership(targetUid, mine, 4);
    }
    function hasMembership(targetUid, classIds, i) {
      return classIds.size() > i
             && exists(/databases/$(database)/documents/memberships/$(targetUid + '_' + classIds[i]));
    }
    // classIds에 새 반 id 하나를 이어붙이는 자기 수정인지 검증합니다.
    //  · 정확히 한 개만, 끝에 추가(순서 변경·복수 추가·삭제 금지)
    //  · 그 반의 내 memberships 문서가 실제로 있어야 함(가입을 실제로 마친 뒤에만
    //    호출하므로, 이 시점엔 이미 커밋돼 있음 — lib/store.js의 joinClass 참고)
    function isValidClassIdsAppend() {
      let before = resource.data.get('classIds', []);
      let after = request.resource.data.get('classIds', []);
      // 뒤에 새로 붙인 값(끝 원소)이 정확히 새로 추가된 것이어야 합니다.
      // (list + list 연결은 이 규칙 엔진이 지원하지 않아, 순서 보존 대신
      // 집합 연산으로 "기존 값은 그대로 + 이 값 하나만 늘어남"을 검증합니다
      // — classIds는 hasAny()로만 쓰여 순서가 의미 없으므로 이걸로 충분합니다.)
      let added = after[after.size() - 1];
      return after is list && after.size() == before.size() + 1
             && added is string && added != ''
             && before.toSet().difference(after.toSet()).size() == 0
             && after.toSet().difference(before.toSet()).hasOnly([added])
             && exists(/databases/$(database)/documents/memberships/$(uid() + '_' + added));
    }
    // 교사(최고 관리자 포함) — 교사용 기능 접근 관문
    function isTeacher() {
      return signedIn() &&
        (userRole() == 'teacher' || userRole() == 'admin');
    }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ── 반 소유권 헬퍼 ────────────────────────────────────────
    // 반 개설자 uid / 그 반의 소유 교사인지 / 소속 멤버인지.
    function classOwnerUid(cId) {
      return get(/databases/$(database)/documents/classes/$(cId)).data.createdBy;
    }
    function isClassArchived(cId) {
      return get(/databases/$(database)/documents/classes/$(cId)).data.get('archived', false) == true;
    }
    function ownsClass(cId) {
      // isTeacher()가 false면 &&에서 단락되어 get을 수행하지 않음(학생 비용 없음)
      return isTeacher() && classOwnerUid(cId) == uid();
    }
    // 쓰기 전용 판정 — 소유 교사라도 반이 보관 상태면 그 반의 데이터는 편집 불가.
    // (classes 문서 자체의 수정 — 이름 변경·보관 토글 — 은 이 함수를 쓰지 않고
    //  ownsClass만으로 항상 허용합니다. 그래야 보관 해제 자체가 막히지 않음)
    function ownsClassEditable(cId) {
      return ownsClass(cId) && !isClassArchived(cId);
    }
    // 보관된 반은 학생도 접근 불가 — 소속 여부와 별개로 항상 거부.
    function isClassMember(cId) {
      return !isClassArchived(cId)
             && exists(/databases/$(database)/documents/memberships/$(uid() + '_' + cId));
    }
    // 그 반이 지정한 date에 출석을 받고 있는지 — 교사가 '출석 시작'을 누른
    // 그날(attendanceOpenDate)에만 유효합니다. 종료를 깜빡 잊고 다음 날이
    // 돼도 날짜가 안 맞아 다시 막히므로, attendanceOpen 하나만으로는 안 되고
    // 두 값을 함께 봅니다.
    function isClassAttendanceOpenFor(cId, date) {
      let cls = get(/databases/$(database)/documents/classes/$(cId)).data;
      return cls.get('attendanceOpen', false) == true
             && cls.get('attendanceOpenDate', '') == date;
    }

    // ── 과일 바구니 ──────────────────────────────────────────
    // 문서 모양 — 정해 둔 칸만, 제 반·제 uid로.
    // 이벤트: entered(응모) · declined(응모 안 함)는 둘 중 하나만 참이고,
    // 응모하려면 과일을 1개 이상 내놓았어야 합니다.
    function fruitBasketShapeOk(cId, sUid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['classId', 'uid', 'donated', 'entered', 'enteredAt',
                               'declined', 'decidedAt', 'receivedAt', 'receivedBy',
                               'updatedAt'])
             && d.classId == cId && d.uid == sUid
             && d.donated is int && d.donated >= 0 && d.donated <= 100000
             && d.entered is bool
             && d.get('declined', false) is bool
             && !(d.entered == true && d.get('declined', false) == true)
             && (d.entered != true || d.donated >= 1);
    }
    // 학생 쓰기에서 접수 칸은 못 건드리고, **접수된 뒤에는 아무것도** 못 바꿉니다
    // — 선생님이 응모를 접수하면 내놓은 과일과 선택이 최종 제출됩니다.
    function fruitEventStudentOk() {
      let d = request.resource.data;
      let o = resource.data;
      return o.get('receivedBy', null) == null
             && d.get('receivedAt', null) == null
             && d.get('receivedBy', null) == null;
    }
    // 바구니가 늘어난 만큼(after − before) 같은 묶음에서 제 과일이 줄었는지.
    // 줄었으면(기부 취소) 그만큼 제 과일이 늘었는지 — 식 하나가 양쪽을 다
    // 봅니다. 그대로면(응모만) 과일을 볼 까닭이 없습니다.
    function fruitDonationMatches(cId, sUid, before, after) {
      let p = /databases/$(database)/documents/rewards/$(cId + '_' + sUid);
      return after == before
             || (get(p).data.count - getAfter(p).data.count == after - before);
    }
    // 학생이 제 과일을 바꾸는 쓰기 — 줄어든 만큼 제 바구니가 같은 묶음에서
    // 늘어야 하고, 늘어난 만큼(기부 취소) 바구니가 줄어야 합니다(위 함수의 짝).
    // d = 줄어든 과일 수(취소면 음수).
    function fruitBasketGainMatches(cId, sUid, d) {
      let p = /databases/$(database)/documents/classes/$(cId)/fruitBasket/$(sUid);
      return existsAfter(p)
             && getAfter(p).data.donated - (exists(p) ? get(p).data.donated : 0) == d;
    }

    // ── 수업 노트(코넬) 본문 검사 ─────────────────────────────
    // 학생이 자기 노트에, 문서 ID가 정한 자리에 쓰는지. 칸마다 길이도 봅니다.
    // (필기 칸은 서식이 붙은 HTML이라 넉넉히 둡니다 — 태그가 길이를 먹습니다)
    // 손들기에 함께 오는 태그·메모. 없어도 되지만, 있으면 글자여야 하고
    // 메모는 1000자까지입니다(교사 화면에 그대로 뿌려지는 글이라서요).
    function questionSignalSaid() {
      return request.resource.data.get('tag', '') is string
             && request.resource.data.get('tag', '').size() <= 20
             && request.resource.data.get('note', '') is string
             && request.resource.data.get('note', '').size() <= 1000;
    }

    // 손들기 대화의 한 마디 — 모양. 길이는 lib/signalThread.js의
    // SIGNAL_MESSAGE_MAX와 같은 값입니다. 고치기는 없고 쌓기만 합니다.
    // threadId = 그 대화 줄기(손을 새로 들 때마다 새 값). 첫 물음
    // (kind 'first')만 글이 비어도 됩니다 — '내용 없이 손들기'.
    function signalMessageOk(cId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['classId', 'uid', 'threadId', 'from', 'kind', 'tag',
                               'text', 'byUid', 'at'])
             && d.classId == cId && d.uid is string
             && d.threadId is string && d.threadId.size() > 0 && d.threadId.size() <= 40
             && d.from in ['student', 'teacher']
             && (!('kind' in d) || (d.kind == 'first' && d.from == 'student'))
             && d.get('tag', '') is string && d.get('tag', '').size() <= 20
             && d.text is string && d.text.size() <= 1000
             && (d.text.size() > 0 || d.get('kind', '') == 'first')
             && d.byUid == uid()
             && d.at == request.time;
    }

    // ── 돌발 퀴즈 ─────────────────────────────────────────────
    // 길이 천장은 lib/popQuiz.js의 QUIZ_*_MAX와 같은 값입니다.
    function popQuizShapeOk(cId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['classId', 'kind', 'title', 'desc', 'boardId', 'boardTitle',
                               'byUid', 'open', 'createdAt', 'closedAt'])
             && d.classId == cId
             && d.kind in ['text', 'code']
             && d.title is string && d.title.size() > 0 && d.title.size() <= 200
             && d.desc is string && d.desc.size() <= 5000
             && (d.boardId == null || d.boardId is string)
             && d.boardTitle is string && d.boardTitle.size() <= 200
             && d.byUid == uid()
             && d.open == true
             && d.createdAt == request.time
             && d.closedAt == null;
    }
    function popQuizOf(cId, qId) {
      return get(/databases/$(database)/documents/classes/$(cId)/popQuizzes/$(qId)).data;
    }
    // 학생이 보내는 답 — 제 자리에, 그 퀴즈의 종류로, 정해 둔 칸만.
    function popAnswerShapeOk(cId, qId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['classId', 'quizId', 'uid', 'kind', 'text', 'output', 'status',
                               'submittedAt', 'returnNote', 'reviewedAt', 'reviewedBy', 'history'])
             && d.classId == cId && d.quizId == qId && d.uid == uid()
             && d.kind == popQuizOf(cId, qId).kind
             && d.text is string && d.text.size() > 0 && d.text.size() <= 20000
             && d.output is string && d.output.size() <= 10000
             && d.status == 'submitted'
             && d.submittedAt == request.time;
    }

    // 반송 → 다시 보내기 때 지난 한 차례(보냈던 답 + 선생님 한 마디)를 이력
    // 끝에 붙입니다(lib/popQuiz.js의 nextQuizHistory). 앞의 이력은 그대로여야 하고
    // (가득 차면 맨 앞 하나만 밀려남 — QUIZ_HISTORY_MAX 20), 붙이는 한 줄은
    // **고치기 전 문서의 값 그대로**여야 합니다 — 학생이 지난 답을 꾸며 넣지 못하게.
    function popHistoryLastOk(h) {
      return h.keys().hasOnly(['text', 'output', 'note', 'submittedAt', 'returnedAt'])
             && h.text == resource.data.text
             && h.output == resource.data.output
             && h.note == resource.data.get('returnNote', '')
             && h.submittedAt == resource.data.submittedAt
             && h.returnedAt == resource.data.get('reviewedAt', null);
    }
    // nw[0:0](빈 자르기)는 평가 오류가 나 첫 차례는 따로 봅니다(실측).
    function popHistoryOk() {
      let old = resource.data.get('history', []);
      let nw = request.resource.data.get('history', []);
      return nw is list && nw.size() >= 1 && nw.size() <= 20
             && ((nw.size() == old.size() + 1 && (old.size() == 0 || nw[0:old.size()] == old))
                 || (old.size() == 20 && nw.size() == 20 && nw[0:19] == old[1:20]))
             && popHistoryLastOk(nw[nw.size() - 1]);
    }

    function isMyCornellNote(cId, nId) {
      return request.resource.data.uid == uid()
             && request.resource.data.classId == cId
             && request.resource.data.date is string
             && nId == (uid() + '_' + request.resource.data.date)
             && request.resource.data.cue is string
             && request.resource.data.cue.size() <= 1000
             && request.resource.data.notes is string
             && request.resource.data.notes.size() <= 20000
             && request.resource.data.summary is string
             && request.resource.data.summary.size() <= 2000;
    }

    // ── 답변 반응(엄지 척/하트/웃는 얼굴) 배열 토글 검증 ──────────
    //  · meTooIds와 같은 방식 — 중복 없이, 이번에 바뀐 사람은 오직 나(uid())뿐이어야 함
    function isOwnReactionToggle(field) {
      let before = resource.data.get(field, []);
      let after = request.resource.data.get(field, []);
      return after.size() == after.toSet().size()
             && after.toSet().difference(before.toSet()).hasOnly([uid()])
             && before.toSet().difference(after.toSet()).hasOnly([uid()]);
    }

    // ── 공부방 보드 헬퍼 ──────────────────────────────────────
    function studyBoardClassId(bId) {
      return get(/databases/$(database)/documents/studyBoards/$(bId)).data.classId;
    }
    function ownsBoard(bId) {
      return ownsClass(studyBoardClassId(bId));
    }
    function ownsBoardEditable(bId) {
      return ownsClassEditable(studyBoardClassId(bId));
    }
    function isBoardClassMember(bId) {
      return isClassMember(studyBoardClassId(bId));
    }
    // editMode가 없는 보드 문서(콘솔에서 직접 만들었거나 예전 데이터)에서도
    // 안전하게 판정합니다. 직접 참조(.editMode)하면 필드가 없을 때 규칙 평가가
    // 오류로 끝나 학생 카드 쓰기가 통째로 막힙니다. 보드는 항상 'open'으로
    // 만들어지므로 기본값도 'open'이 맞습니다.
    function isBoardLocked(bId) {
      return get(/databases/$(database)/documents/studyBoards/$(bId)).data.get('editMode', 'open') == 'locked';
    }
    // '선생님 보드'(type: notice) — 교사 전용 쓰기. 학생은 읽기만(첨부 다운로드 포함).
    function isNoticeBoard(bId) {
      return get(/databases/$(database)/documents/studyBoards/$(bId)).data.type == 'notice';
    }
    // 모둠 활동 보드 여부 / '함께 보기' 여부
    function isGroupBoard(bId) {
      return get(/databases/$(database)/documents/studyBoards/$(bId)).data.get('activityType', 'individual') == 'group';
    }
    function isSharedBoard(bId) {
      return get(/databases/$(database)/documents/studyBoards/$(bId)).data.viewMode == 'shared';
    }
    // 이 카드가 모둠 카드이고 내가 그 모둠의 구성원인지
    function isMyGroupCard() {
      return resource.data.get('memberUids', []).hasAny([uid()]);
    }

    // ── 사용자 프로필 ─────────────────────────────────────────
    // 실명·이메일 등 식별 정보(PII)가 여기에만 있으므로, 읽기는 본인+교사로 제한.
    // (질문 게시판은 전체 공유라 교사가 타 반 학생 실명도 확인해야 하므로 교사 전체 허용)
    match /users/{userId} {
      // 본인·교사에 더해, 공부방에서 같은 반인 학생끼리도 서로 읽을 수 있게
      // 열어 둡니다(급우 이름·학번 명단 표시용 — 공부방은 원래 실명 공간이라
      // 카드를 쓰면 어차피 이름이 보이므로, 아직 카드를 안 쓴 급우도 자리를
      // 미리 보여주려면 이 정도는 필요합니다). isClassmateOf는 내 classIds만
      // 보고 대상은 memberships로 확인하므로, 상대가 아직 이 기능 배포 뒤
      // 접속 전이라 classIds가 비어 있어도(자가 치유 전) 곧바로 보입니다.
      allow read: if signedIn() && (userId == uid() || isTeacher() || isClassmateOf(userId));
      // 본인만 생성, 가입 시 role은 'student' 고정 (스스로 승격 불가).
      // 가입은 **구글 계정으로만** 받습니다(sign_in_provider — 토큰의 값이라
      // 위조 불가). 학교 도메인 제한·등록 코드는 없습니다(공개 운영) — 대신
      // 반에 들어가는 관문이 교사가 만든 참여 코드이고, 그 확인은 아래
      // memberships 규칙이 joinCodes를 get()으로 대조해 합니다. 반에 들지 못한 계정은
      // 소속이 없어 어느 반의 자료도 읽지 못합니다.
      // 선생님은 학생으로 만든 뒤 교사 가입 코드로 바꿉니다(아래 update의
      // '교사 가입 코드' 갈래). requestedRole=='teacher'는 옛 '승인 신청'
      // 표시라 받아 두기만 합니다(관리자가 역할 관리 창에서 바꿔 줄 수 있음).
      allow create: if signedIn() && userId == uid()
                    && request.auth.token.firebase.sign_in_provider == 'google.com'
                    && request.resource.data.role == 'student'
                    && request.resource.data.get('requestedRole', null) in [null, 'teacher'];
      // 쓰기 범위 — '누가' 뿐 아니라 '어떤 필드를' 쓰는지까지 제한합니다.
      //  · 최고 관리자: 전체. 역할 부여(역할 관리 창)가 여기에 해당합니다.
      //  · 본인: 이메일·아바타·알림토큰·신청 표시만. 닉네임·실명·학번·역할 불가.
      //  · 교사: 학생 관리에 실제로 쓰는 필드만(StudentEditModal의 프로필 수정,
      //      탈퇴 신청 거절). role은 목록에 없어 교사가 역할을 건드릴 수 없습니다 —
      //      역할 부여는 관리자만(또는 본인이 교사 가입 코드로 학생 → 선생님).
      //      대상도 학생(또는 본인)으로 좁혀, 다른 교사의 프로필은 못 고칩니다.
      //      선생님 신청 승인·거절(requestedRole)은 최고 관리자 전용 화면이라
      //      교사 목록에서 뺐습니다.
      allow update: if signedIn() && (
        isAdmin()
        || (userId == uid()
            && changedOnly(['email','emoji','fcmTokens','requestedRole',
                            'withdrawRequested','withdrawRequestedAt']))
        // classIds는 별도 갈래 — 반에 들어갈 때마다 한 개씩만 이어붙이는
        // 자기 수정만 허용(lib/store.js의 joinClass 참고). 다른 필드와
        // 한 요청에 같이 못 바꾸게 changedOnly를 classIds 하나로 좁힙니다.
        || (userId == uid() && changedOnly(['classIds']) && isValidClassIdsAppend())
        // 교사 가입 코드 — 학생인 본인이 코드를 맞게 넣으면 선생님이 됩니다.
        // 학생 → 선생님 한 방향만(관리자로는 못 올림). 표시 이름·아바타를
        // '선생님'으로 함께 바꾸고, 넣은 코드(teacherCode)가 문서에 남습니다.
        || (userId == uid()
            && resource.data.get('role', 'student') == 'student'
            && request.resource.data.role == 'teacher'
            && changedOnly(['role','teacherCode','teacherAt','displayName','emoji','requestedRole'])
            && teacherCodeOk(request.resource.data.get('teacherCode', '')))
        || (isTeacher()
            && (userId == uid() || resource.data.get('role', 'student') == 'student')
            && changedOnly(['displayName','emoji','realName','email','studentId',
                            'withdrawRequested','withdrawRequestedAt']))
        // 교사가 학생을 반에서 뺄 때 classIds도 함께 줄입니다 — **줄이는
        // 쪽으로만**. 이 값은 급우 프로필 읽기 판정(isClassmateOf)의 기준이라,
        // 소속을 지워도 여기 남아 있으면 그 반 급우들의 이름·학번을 계속 읽을
        // 수 있습니다(append만 가능한 값이라 지금까지 지울 길이 아예 없었음).
        // **늘리는 쪽은 막습니다** — 늘릴 수 있으면 교사가 학생에게 남의 반
        // 명단을 읽을 권한을 얹어 줄 수 있게 됩니다. 반대로 줄이는 것은 늘
        // 권한을 좁히는 쪽이라, 잘못 눌러도 학생이 자기 반에 다시 들어가면
        // (공부방의 ensureClassIdSynced) 스스로 채워집니다.
        || (isTeacher()
            && resource.data.get('role', 'student') == 'student'
            && changedOnly(['classIds'])
            && request.resource.data.get('classIds', []) is list
            && request.resource.data.get('classIds', []).size()
               < resource.data.get('classIds', []).size()
            && request.resource.data.get('classIds', []).toSet()
                 .difference(resource.data.get('classIds', []).toSet()).size() == 0)
      );
      // 프로필 삭제는 관리자만. 교사에게 열어 두면 아무 반 학생이나 지울 수
      // 있어(되돌릴 수 없음) 막습니다 — 학생을 내보낼 때는 '반에서 빼기'.
      allow delete: if isAdmin();
      // (배움나눔의 개인 알림함 users/{uid}/notifications는 서버 함수가 쓰던
      //  자리라 걷었습니다 — match가 없으니 아무도 못 읽고 못 씁니다.)
    }

    // ── 모둠 메모 (학생 ↔ 같은 모둠 학생) ─────────────────────
    //  공부방 '우리 모둠'에서 모둠 친구에게 남기는 짧은 쪽지입니다.
    //  (배움나눔에서 옮겨 온 규칙입니다 — 책 나눔에는 이 쪽지를 쓰는 화면이
    //  없어 지금은 아무도 쓰지 않습니다.)
    //
    //  · 읽기는 **주고받은 두 사람만**. 교사도 못 읽습니다 — 이 쪽지는
    //    누가기록(교사가 학생을 관찰해 적는 글)과 주인이 다릅니다.
    //  · 쓰기는 **같은 기본 모둠일 때만**. 반이 같다는 것만으로 열면
    //    화면에 없는 길로 아무 급우에게나 보낼 수 있게 됩니다.
    //  · 받은 사람은 `read` 한 칸만 바꿉니다(알림에서 치우기).
    //  · 보낸 사람은 자기 글을 지울 수 있습니다. 남의 글은 못 지웁니다.
    match /groupMemos/{mId} {
      // 문서 ID가 아니라 필드(pairKey)로 짝을 적어 둡니다 — 학생 쪽 질의가
      // `where('pairKey','==',…)` 하나로 끝나 새 색인이 필요 없습니다.
      function pairKeyOf(a, b) {
        return a < b ? a + '__' + b : b + '__' + a;
      }
      // 그 반 기본 모둠 하나 안에 둘이 함께 있는지. 모둠은 최대 6개로
      // 규칙이 이미 못 박고 있어(groupAssignments) 여섯 번 펼쳐 봅니다 —
      // 규칙 언어에는 반복이 없습니다.
      function baseGroups(cId) {
        return get(/databases/$(database)/documents/classes/$(cId)/groupAssignments/default).data.get('groups', []);
      }
      function inGroupAt(gs, i, a, b) {
        return gs.size() > i && gs[i].get('memberUids', []).hasAll([a, b]);
      }
      function inSameBaseGroup(cId, a, b) {
        return exists(/databases/$(database)/documents/classes/$(cId)/groupAssignments/default)
               && inSameBaseGroupIn(baseGroups(cId), a, b);
      }
      function inSameBaseGroupIn(gs, a, b) {
        return inGroupAt(gs, 0, a, b) || inGroupAt(gs, 1, a, b) || inGroupAt(gs, 2, a, b)
               || inGroupAt(gs, 3, a, b) || inGroupAt(gs, 4, a, b) || inGroupAt(gs, 5, a, b);
      }

      allow read: if signedIn()
                  && (resource.data.toUid == uid() || resource.data.fromUid == uid());
      allow create: if signedIn()
                    && request.resource.data.fromUid == uid()
                    && request.resource.data.toUid is string
                    && request.resource.data.toUid != uid()
                    && request.resource.data.classId is string
                    && request.resource.data.pairKey == pairKeyOf(uid(), request.resource.data.toUid)
                    && request.resource.data.read == false
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.html is string
                    && request.resource.data.html.size() <= 4000
                    && isClassMember(request.resource.data.classId)
                    && exists(/databases/$(database)/documents/memberships/$(request.resource.data.toUid + '_' + request.resource.data.classId))
                    && inSameBaseGroup(request.resource.data.classId,
                                       uid(), request.resource.data.toUid);
      // 받은 사람의 '읽음' 표시만. 본문은 누구도 못 고칩니다 — 고칠 수 있으면
      // 상대가 본 뒤에 말이 바뀝니다.
      allow update: if signedIn()
                    && resource.data.toUid == uid()
                    && changedOnly(['read', 'readAt'])
                    && request.resource.data.read == true;
      allow delete: if signedIn() && resource.data.fromUid == uid();
    }

    // ── 질문 (전체 공유) ──────────────────────────────────────
    match /questions/{qId} {
      allow read: if signedIn();
      // createdAt은 반드시 서버 시각. 임의 값(특히 미래 날짜)을 넣으면
      // 주간 랭킹 집계 창에서 영원히 빠지지 않습니다.
      allow create: if signedIn() && request.resource.data.authorId == uid()
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.answerCount == 0
                    && request.resource.data.meTooIds == []
                    && request.resource.data.resolved == false;
      allow update: if signedIn() && (
        (resource.data.authorId == uid()
          && changedOnly(['title','content','keyword','imageUrl','images',
                          'resolved','reflectionPending','understoodAnswerId','reflection']))
        || isTeacher()
        || (changedOnly(['meTooIds'])
            && resource.data.authorId != uid()
            // 배열에 같은 uid가 여러 번 들어가지 못하게 막습니다.
            // 아래 두 줄은 집합(toSet)으로만 비교하기 때문에, 중복만으로는
            // 차집합이 달라지지 않아 ['a','나','나','나'] 같은 배열이 그대로
            // 통과했습니다. 공감 수와 랭킹은 배열 길이로 세므로(questionRanking.js),
            // 학생이 자기 uid를 여러 번 넣어 수치를 부풀릴 수 있었습니다.
            && request.resource.data.meTooIds.size()
                 == request.resource.data.meTooIds.toSet().size()
            && request.resource.data.meTooIds.toSet()
                 .difference(resource.data.meTooIds.toSet()).hasOnly([uid()])
            && resource.data.meTooIds.toSet()
                 .difference(request.resource.data.meTooIds.toSet()).hasOnly([uid()]))
      );
      allow delete: if signedIn() && (resource.data.authorId == uid() || isTeacher());

      match /answers/{aId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == uid()
                      && request.resource.data.createdAt == request.time;
        allow update: if signedIn() && (
          (resource.data.authorId == uid()
            && changedOnly(['content','imageUrl','images']))
          || isTeacher()
          || (changedOnly(['understood'])
              && get(/databases/$(database)/documents/questions/$(qId)).data.authorId == uid())
          // 답변에 다는 작은 반응(엄지 척/하트/웃는 얼굴) — 정답 여부와 상관없이
          // 응답자의 노력을 칭찬하는 용도라 본인 답변엔 못 답니다(meTooIds와 같은 이유).
          || (resource.data.authorId != uid()
              && changedOnly(['thumbsUpIds'])
              && isOwnReactionToggle('thumbsUpIds'))
          || (resource.data.authorId != uid()
              && changedOnly(['heartIds'])
              && isOwnReactionToggle('heartIds'))
          || (resource.data.authorId != uid()
              && changedOnly(['smileIds'])
              && isOwnReactionToggle('smileIds'))
        );
        allow delete: if signedIn() && (resource.data.authorId == uid() || isTeacher());
      }
    }

    // ── 공지 — 교사만 작성, 삭제는 작성한 본인이나 최고 관리자만 ──
    //   (다른 반 교사가 남의 공지를 지울 수 없도록 — 공지는 전체 공유라
    //    작성자 제한이 없으면 아무나 서로의 공지를 지울 수 있었습니다)
    match /notices/{nId} {
      allow read: if signedIn();
      allow create: if isTeacher() && request.resource.data.authorId == uid();
      allow delete: if isAdmin() || (isTeacher() && resource.data.authorId == uid());
    }

    // ── 키워드 — 읽기 모두, 생성/수정/삭제는 교사 (전체 공유) ──
    match /keywords/{kId} {
      allow read: if signedIn();
      allow create, update, delete: if isTeacher();
    }

    // ── meta/keywordsSeeded — 기본 키워드를 이미 한 번 심었는지 기록 ──
    //  · keywords 컬렉션이 비어 있을 때, "한 번도 안 심음"과 "교사가 전부
    //    지움"을 구분하기 위한 플래그. 없으면(과거 시드 이력 없음) 기본
    //    키워드를 심고, 있으면 비워 둔 채로 둡니다.
    match /meta/{docId} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }

    // ── 반(클래스) ────────────────────────────────────────────
    //  · 이름은 공개 메타데이터(입장 코드 확인 등) → 읽기는 로그인 사용자.
    //    교사 화면은 본인 개설 반만 클라이언트에서 필터링해 표시.
    //  · 생성: 교사 본인이 개설자. 수정(이름·보관 토글): 개설자 또는 최고 관리자.
    //  · 삭제: 개설자(보관된 반만) 또는 최고 관리자 — 위험도가 높아 보관을
    //    먼저 거치도록 강제합니다.
    match /classes/{cId} {
      allow read: if signedIn();
      allow create: if isTeacher() && request.resource.data.createdBy == uid();
      allow update: if isAdmin()
                    || (isTeacher() && resource.data.createdBy == uid());
      allow delete: if isAdmin()
                    || (isTeacher() && resource.data.createdBy == uid()
                        && resource.data.get('archived', false) == true);

      // ── 언제든 질문하기(손들기) ─────────────────────────────
      //  · 경로 = classes/{classId}/questionSignals/{uid}
      //  · 학생은 자기 손들기만 켜고/끄고, 담당 교사는 반 전체 목록만 확인합니다.
      //  · 태그(tag)와 메모(note)를 함께 보냅니다 — '무엇 때문에 손을
      //    들었나'. 둘 다 없어도 손은 올라갑니다(그냥 부르는 손). 메모는
      //    교사 화면에 그대로 뿌려지므로 길이를 여기서 못 박습니다
      //    (lib/questionTags.js의 QUESTION_NOTE_MAX와 같은 값).
      match /questionSignals/{studentUid} {
        allow get: if signedIn() && (
          isAdmin()
          || ownsClass(cId)
          || studentUid == uid()
        );
        allow list: if signedIn() && (
          isAdmin()
          || ownsClass(cId)
        );
        allow create: if signedIn()
                      && studentUid == uid()
                      && request.resource.data.uid == uid()
                      && request.resource.data.classId == cId
                      && isClassMember(cId)
                      && questionSignalSaid()
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.updatedAt == request.time;
        allow update: if signedIn()
                      && studentUid == uid()
                      && resource.data.uid == uid()
                      && request.resource.data.uid == resource.data.uid
                      && request.resource.data.classId == cId
                      && request.resource.data.createdAt == resource.data.createdAt
                      && isClassMember(cId)
                      && questionSignalSaid()
                      && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn() && (
          studentUid == uid()
          || isAdmin()
          || ownsClassEditable(cId)
        );
      }

      // ── 손들기 대화 ───────────────────────────────────────
      //  · 경로 = classes/{classId}/signalMessages/{자동 id}, uid = 그 학생.
      //    손든 학생과 교사가 주고받는 말 — 같은 threadId가 한 줄기(첫 물음
      //    kind 'first' + 오간 말, lib/signalThread.js). **지우지 않고 쌓아**
      //    교사가 자리표에서 '손들고 대화한 이력'으로 다시 봅니다.
      //  · 읽기: 담당 교사(목록 전체) · 그 학생 본인(where uid == 나).
      //  · 쓰기: 학생은 제 대화에, **손이 올라가 있을 때만**. 교사는 담당 반.
      //    고치기는 없음. 지우기는 담당 교사(앱에는 아직 그 화면이 없음).
      //  · 학생의 '읽음'은 제 손들기 문서의 seenAt(위 questionSignals update).
      //    시험 tests/rules/signalMessages.test.mjs.
      match /signalMessages/{msgId} {
        allow get, list: if signedIn() && (
          isAdmin()
          || ownsClass(cId)
          || resource.data.uid == uid()
        );
        allow create: if signedIn() && signalMessageOk(cId) && (
          (request.resource.data.from == 'student'
            && request.resource.data.uid == uid()
            && isClassMember(cId)
            && exists(/databases/$(database)/documents/classes/$(cId)/questionSignals/$(uid())))
          || (request.resource.data.from == 'teacher'
            && (isAdmin() || ownsClassEditable(cId)))
        );
        allow update: if false;
        allow delete: if isAdmin() || ownsClassEditable(cId);
      }

      // ── 돌발 퀴즈 ─────────────────────────────────────────
      //  · 경로 = classes/{classId}/popQuizzes/{qId} (+ submissions/{학생 uid})
      //    셈과 모양은 lib/popQuiz.js. 반마다 열린 퀴즈는 하나 — 보낼 때 앞의
      //    것을 닫는 일은 앱이 한 묶음으로 합니다(규칙은 개수를 셀 수 없음).
      //  · 퀴즈: 읽기는 반 학생·담당 교사. 만들기·닫기·지우기는 담당 교사.
      //    고치기는 '닫기'(open → false) 한 가지뿐 — 보낸 물음은 안 바뀝니다.
      //  · 답: 학생은 **제 자리에, 열린 퀴즈에만**, 처음이거나 반송됐을 때만
      //    보냅니다(보낸 뒤 · 과일을 받은 뒤에는 못 고침). 교사는 상태 칸만 —
      //    반송(보낸 답 · 열린 퀴즈) · 완료(보낸 답) · 과일(보낸 답 또는 반송한 답).
      //    다시 보낼 때 지난 차례가 history에 쌓여 오간 말이 남습니다(popHistoryOk).
      //    읽기는 그 학생과 담당 교사(목록은 교사만). 시험 tests/rules/popQuiz.test.mjs.
      match /popQuizzes/{qId} {
        allow read: if signedIn() && (isAdmin() || ownsClass(cId) || isClassMember(cId));
        allow create: if signedIn() && (isAdmin() || ownsClassEditable(cId))
                      && popQuizShapeOk(cId);
        allow update: if signedIn() && (isAdmin() || ownsClassEditable(cId))
                      && changedOnly(['open', 'closedAt'])
                      && request.resource.data.open == false
                      && request.resource.data.closedAt == request.time;
        allow delete: if isAdmin() || ownsClassEditable(cId);

        match /submissions/{aUid} {
          allow get: if signedIn() && (isAdmin() || ownsClass(cId) || aUid == uid());
          allow list: if signedIn() && (isAdmin() || ownsClass(cId));
          allow create: if signedIn() && aUid == uid() && isClassMember(cId)
                        && popQuizOf(cId, qId).open == true
                        && popAnswerShapeOk(cId, qId)
                        && !request.resource.data.keys().hasAny(['returnNote', 'reviewedAt', 'reviewedBy', 'history']);
          // 반송된 답을 고쳐 다시 보내기
          allow update: if signedIn() && aUid == uid() && isClassMember(cId)
                        && popQuizOf(cId, qId).open == true
                        && resource.data.status == 'returned'
                        && changedOnly(['kind', 'text', 'output', 'status', 'submittedAt', 'history'])
                        && popAnswerShapeOk(cId, qId)
                        // 이력을 안 건드리는 옛 화면도 그대로 받습니다(배포 사이).
                        && (request.resource.data.get('history', null) == resource.data.get('history', null)
                            || popHistoryOk());
          // 교사 — 반송(한 마디는 선택)
          allow update: if signedIn() && (isAdmin() || ownsClassEditable(cId))
                        && resource.data.status == 'submitted'
                        && popQuizOf(cId, qId).open == true
                        && changedOnly(['status', 'returnNote', 'reviewedAt', 'reviewedBy'])
                        && request.resource.data.status == 'returned'
                        && request.resource.data.returnNote is string
                        && request.resource.data.returnNote.size() <= 500
                        && request.resource.data.reviewedAt == request.time
                        && request.resource.data.reviewedBy == uid();
          // 교사 — 과일을 줬다(그 학생의 퀴즈는 끝)
          allow update: if signedIn() && (isAdmin() || ownsClassEditable(cId))
                        && resource.data.status in ['submitted', 'returned']
                        && changedOnly(['status', 'reviewedAt', 'reviewedBy'])
                        && request.resource.data.status == 'rewarded'
                        && request.resource.data.reviewedAt == request.time
                        && request.resource.data.reviewedBy == uid();
          // 교사 — 완료(과일 없이 답을 인정 · 그 학생의 퀴즈는 끝). 보낸 답에만.
          allow update: if signedIn() && (isAdmin() || ownsClassEditable(cId))
                        && resource.data.status == 'submitted'
                        && changedOnly(['status', 'reviewedAt', 'reviewedBy'])
                        && request.resource.data.status == 'completed'
                        && request.resource.data.reviewedAt == request.time
                        && request.resource.data.reviewedBy == uid();
          allow delete: if isAdmin() || ownsClassEditable(cId);
        }
      }

      // ── 공부방 출석부 ─────────────────────────────────────
      //  · 경로 = classes/{classId}/attendanceRecords/{date_uid}
      //  · 학생은 자기 출석 기록만 만들고 읽습니다. 교사는 반 전체 기록을 보고,
      //    좌석형의 '출결 수정'으로 학생 기록을 만들거나(manualBy) 지웁니다.
      match /attendanceRecords/{recordId} {
        allow read: if signedIn() && (
          isAdmin()
          || ownsClass(cId)
          || resource.data.uid == uid()
        );
        allow create: if signedIn() && (
                        // 학생 — 자기 출석, 교사가 그날 출석을 연 동안만
                        (request.resource.data.uid == uid()
                          && request.resource.data.classId == cId
                          && recordId == (request.resource.data.date + '_' + uid())
                          && request.resource.data.date is string
                          && isClassMember(cId)
                          && isClassAttendanceOpenFor(cId, request.resource.data.date)
                          && !request.resource.data.keys().hasAny(['manualBy'])
                          && request.resource.data.attendedAt == request.time
                          && request.resource.data.createdAt == request.time)
                        // 담당 교사 — 출결 수정(좌석형). 출석을 열지 않았어도,
                        // 지난 날짜여도 됩니다. 누가 남겼는지(manualBy)를 적습니다.
                        || ((isAdmin() || ownsClassEditable(cId))
                          && request.resource.data.classId == cId
                          && request.resource.data.uid is string
                          && request.resource.data.date is string
                          && recordId == (request.resource.data.date + '_' + request.resource.data.uid)
                          && request.resource.data.manualBy == uid()
                          && request.resource.data.attendedAt == request.time
                          && request.resource.data.createdAt == request.time)
                      );
        // 고치기는 없습니다(지우고 다시 만듦). 지우기(출석 → 결석)는 담당 교사만.
        allow update: if false;
        allow delete: if isAdmin() || ownsClassEditable(cId);
      }

      // ── 과일 바구니 — 학생이 제 과일을 내놓아 반이 함께 모읍니다 ──
      //  · 경로 = classes/{classId}/fruitBasket/{학생 uid}
      //    { classId, uid, donated(지금까지 내놓은 합), entered, enteredAt?, updatedAt }
      //  · 읽기는 반 학생 모두와 담당 교사 — 바구니 합계를 학생도 봅니다.
      //  · 쓰기는 **본인 문서만**. donated가 늘어난 만큼 같은 쓰기 묶음
      //    (트랜잭션)에서 rewards의 count가 줄어야 합니다(getAfter로 맞대어 봄).
      //    그래야 '과일은 그대로인데 바구니만 느는' 쓰기가 막힙니다.
      //  · **기부 취소** — donated를 줄이는 쓰기는 **응모하기 전에만**(지금도,
      //    쓰고 난 뒤에도 entered가 참이 아닐 때). 줄어든 만큼 같은 묶음에서
      //    제 과일이 늘어야 합니다(같은 fruitDonationMatches — 부호만 반대).
      //  · 이벤트 — entered(응모)는 과일이 1개 이상일 때만 참. declined(응모
      //    안 함)와 둘 중 하나. 학생은 선생님이 **접수**(receivedAt·receivedBy)
      //    하기 전까지 선택을 거둘 수 있고, 접수된 뒤에는 그 문서를 아예 못
      //    씁니다(내놓은 과일이 최종 제출 — 내놓기·거두기·선택 모두 막힘). 접수
      //    칸은 담당 교사만 씁니다. 목표(100개)는 여러 문서의 합이라 규칙이
      //    셀 수 없어 화면이 판정합니다(lib/fruitBasket.js).
      //  · 지우기는 담당 교사(다시 모을 때). 시험 tests/rules/fruitBasket.test.mjs.
      match /fruitBasket/{sUid} {
        allow read: if signedIn() && (isAdmin() || ownsClass(cId) || isClassMember(cId));
        allow create: if signedIn() && sUid == uid() && isClassMember(cId)
                      && fruitBasketShapeOk(cId, sUid)
                      && !request.resource.data.keys().hasAny(['receivedAt', 'receivedBy'])
                      && fruitDonationMatches(cId, sUid, 0, request.resource.data.donated);
        allow update: if signedIn() && sUid == uid() && isClassMember(cId)
                      && fruitBasketShapeOk(cId, sUid)
                      && fruitEventStudentOk()
                      && (request.resource.data.donated >= resource.data.donated
                          || (resource.data.entered != true
                              && request.resource.data.entered != true))
                      && fruitDonationMatches(cId, sUid, resource.data.donated, request.resource.data.donated);
        // 교사의 이벤트 접수 — 접수 칸 둘만, 무언가를 고른 학생 문서에만.
        allow update: if signedIn() && ownsClassEditable(cId)
                      && changedOnly(['receivedAt', 'receivedBy'])
                      && request.resource.data.receivedAt == request.time
                      && request.resource.data.receivedBy == uid()
                      && (resource.data.entered == true
                          || resource.data.get('declined', false) == true);
        // 교사의 이벤트 접수(100개 넘을 때) — 걸친 한 학생의 과일을 처리한
        // 만큼 줄여 남깁니다(넘친 몫은 다음 이벤트로). 응모한 문서에만, 줄이기만,
        // 1개 이상 남게. 과일 수는 안 건드립니다(이미 담을 때 빠짐).
        allow update: if signedIn() && ownsClassEditable(cId)
                      && changedOnly(['donated', 'updatedAt'])
                      && resource.data.entered == true
                      && request.resource.data.donated is int
                      && request.resource.data.donated >= 1
                      && request.resource.data.donated < resource.data.donated
                      && request.resource.data.updatedAt == request.time;
        allow delete: if isAdmin() || ownsClassEditable(cId);
      }

      // ── 과일 바구니 이벤트 기록 — 교사가 '이벤트 접수'를 누를 때 한 장 ──
      //  · 경로 = classes/{classId}/fruitEvents/{auto}
      //    { classId, byUid, at, total, entrants:[{uid,donated}], declined:[uid] }
      //  · 접수하면 바구니 문서를 모두 지워 새 이벤트를 시작하므로(담긴 과일은
      //    처리됨), 누가 응모했는지를 여기에만 남깁니다. 같은 writeBatch.
      //  · 읽기 · 만들기 · 지우기는 담당 교사. 고치기는 없음(기록).
      match /fruitEvents/{eId} {
        allow read: if signedIn() && (isAdmin() || ownsClass(cId));
        allow create: if signedIn() && ownsClassEditable(cId)
                      && request.resource.data.keys().hasOnly(['classId', 'byUid', 'at', 'total', 'entrants', 'declined'])
                      && request.resource.data.classId == cId
                      && request.resource.data.byUid == uid()
                      && request.resource.data.at == request.time
                      && request.resource.data.total is int && request.resource.data.total >= 0
                      && request.resource.data.entrants is list && request.resource.data.entrants.size() <= 300
                      && request.resource.data.declined is list && request.resource.data.declined.size() <= 300;
        allow update: if false;
        allow delete: if isAdmin() || ownsClassEditable(cId);
      }

      // ── 과일 지급 이력 ─────────────────────────────────────
      //  · 경로 = classes/{classId}/rewardEvents/{auto}
      //  · rewards는 누적 총계 하나뿐이라 '언제 몇 개 받았나'가 남지 않습니다.
      //    참여의 변화를 보려면 시계열이 필요해 지급할 때마다 한 건 적습니다.
      //    총계와 같은 트랜잭션에서 쓰므로 둘이 어긋나지 않습니다.
      //  · 읽기는 본인·담당 교사·관리자. 학생이 자기 리포트에서 자기 것만
      //    조회합니다(uid로 거른 쿼리).
      //  · 이력은 고치거나 지울 수 없습니다 — 고칠 수 있으면 이력이 아닙니다.
      //    (반은 지우지 않고 보관만 합니다 — 학기 정리는 콘솔에서.)
      match /rewardEvents/{eId} {
        allow read: if signedIn() && (
          isAdmin()
          || ownsClass(cId)
          || resource.data.uid == uid()
        );
        allow create: if (isAdmin() || ownsClassEditable(cId))
                      && request.resource.data.classId == cId
                      && request.resource.data.uid is string
                      && request.resource.data.delta is int
                      && request.resource.data.count is int
                      && request.resource.data.count >= 0
                      && request.resource.data.count <= 100
                      && request.resource.data.byUid == uid()
                      && request.resource.data.at == request.time;
        allow update, delete: if false;
      }

      // ── 손들기 이력 ─────────────────────────────────────────
      //  · 경로 = classes/{classId}/signalEvents/{auto}
      //  · questionSignals는 '지금 손든 사람'만 담고, 손이 내려가면 문서가
      //    지워집니다. 그래서 '누가 언제 손을 들었나'가 전혀 남지 않아
      //    참여의 변화를 볼 수 없었습니다. 여기에 한 건 남깁니다.
      //  · 교사가 '확인'을 눌러 받아 준 손만 적습니다. '닫기'로 내린 손은
      //    잘못 눌린 것이라 세지 않습니다(그래서 create만 있고 종류가 없음).
      //  · 읽기는 본인·담당 교사·관리자 — rewardEvents와 같은 기준입니다.
      //  · 이력은 고치거나 지울 수 없습니다.
      match /signalEvents/{eId} {
        allow read: if signedIn() && (
          isAdmin()
          || ownsClass(cId)
          || resource.data.uid == uid()
        );
        allow create: if (isAdmin() || ownsClassEditable(cId))
                      && request.resource.data.classId == cId
                      && request.resource.data.uid is string
                      && request.resource.data.byUid == uid()
                      && request.resource.data.at == request.time;
        allow update, delete: if false;
      }

      // ── 반 공지 발송 이력 ───────────────────────────────────
      //  · 경로 = classes/{classId}/classNotices/{auto}
      //  · 공지는 학생 알림으로만 갔고 보낸 쪽에는 아무것도 안 남았습니다.
      //    무엇을 언제 보냈는지 교사가 확인할 수 있게 여기에 남깁니다.
      //  · **이 문서가 곧 공지입니다**(서버 함수 없이). 교사가 여기에 한 장
      //    쓰면 그 반 학생의 알림 벨과 간편 메신저 '공지' 탭이 이것을 읽습니다.
      //  · 읽기는 담당 교사 · 관리자 · 그 반 학생.
      //  · 쓰기는 담당 교사(보관된 반 불가) — 칸을 못 박고 글은 500자.
      //    보낸 공지는 고치거나 지울 수 없습니다(학생이 이미 읽었을 수 있음).
      match /classNotices/{nId} {
        allow read: if signedIn() && (isAdmin() || ownsClass(cId) || isClassMember(cId));
        allow create: if signedIn() && (isAdmin() || ownsClassEditable(cId))
                      && request.resource.data.keys().hasOnly(
                           ['classId','text','sentCount','senderUid','senderName','sentAt'])
                      && request.resource.data.classId == cId
                      && request.resource.data.senderUid == uid()
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500
                      && request.resource.data.sentCount is int
                      && request.resource.data.senderName is string
                      && request.resource.data.senderName.size() <= 40
                      && request.resource.data.sentAt == request.time;
        allow update, delete: if false;
      }

      // ── 수업 메모 ───────────────────────────────────────────
      //  · 경로 = classes/{classId}/lessonMemos/{auto}
      //  · 수업 중에 교사가 짧게 적어 두는 메모입니다. 학생 관찰 기록
      //    (studentNotes)과 다릅니다 — 그쪽은 '학생 한 명에 대한 기록'이고
      //    이쪽은 '그 수업 시간에 대한 메모'라 학생과 엮이지 않습니다.
      //  · 담당 교사·관리자만. 학생은 읽지도 쓰지도 못합니다 — 수업 운영
      //    메모라 학생에게 보일 것을 전제로 쓰지 않습니다.
      //  · 지난 메모를 고치고 지울 수 있게 열어 둡니다. 누가기록·과일 이력과
      //    달리 이건 '남겨야 하는 기록'이 아니라 교사의 수첩입니다.
      match /lessonMemos/{mId} {
        allow read: if signedIn() && (isAdmin() || ownsClass(cId));
        allow create: if (isAdmin() || ownsClassEditable(cId))
                      && request.resource.data.classId == cId
                      && request.resource.data.authorId == uid()
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000
                      && request.resource.data.createdAt == request.time;
        allow update: if (isAdmin() || ownsClassEditable(cId))
                      && request.resource.data.classId == resource.data.classId
                      && request.resource.data.authorId == resource.data.authorId
                      && request.resource.data.createdAt == resource.data.createdAt
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000;
        allow delete: if isAdmin() || ownsClassEditable(cId);
      }

      // ── 수업 노트(코넬) ─────────────────────────────────────
      //  · 경로 = classes/{classId}/cornellNotes/{uid}_{날짜}
      //  · 학생이 수업 중에 적는 필기입니다. 단서(cue) · 필기(notes) ·
      //    요약(summary) 세 칸을 하루 한 장으로 묶습니다.
      //  · 이름이 lessonMemos가 아닌 이유: 바로 위 lessonMemos는 '교사의
      //    수업 메모'입니다. 한 부모 아래 나란히 두면 반드시 헷갈립니다.
      //  · 읽기는 본인과 담당 교사. 교사가 수업이 끝난 뒤 읽고 피드백을
      //    줍니다 — 학생에게도 그렇게 알립니다(서랍에 한 줄).
      //  · **본문 쓰기는 학생 본인만.** 남의 필기를 고칠 수 있으면 그건
      //    그 학생의 기록이 아니게 됩니다. 교사는 feedback 한 칸만 씁니다.
      //  · 학생이 다시 저장할 때 선생님 피드백을 지우지 못하게, update는
      //    feedback이 그대로일 것을 요구합니다(앱은 merge로 써서 그대로 남음).
      //  · 읽기를 get/list로 나눠 둡니다. **아직 안 쓴 날짜를 열어 볼 때**
      //    문서가 없으면 `resource`가 비어 `resource.data.uid`가 오류로 끝나
      //    본인조차 거부됩니다(실측). 그래서 get에는 문서 ID로 판정하는
      //    갈래를 함께 둡니다 — 노트 ID는 쓰기 규칙이 `uid_날짜`로 못 박고
      //    있으므로, ID가 내 uid로 시작한다는 것은 곧 '내 자리'라는 뜻이라
      //    권한이 조금도 넓어지지 않습니다.
      //    이게 없으면 (ㄱ) 새 날 첫 접속마다 조용한 권한 오류가 나고,
      //    (ㄴ) 서랍이 최근 14일치를 훑어 '안 읽은 피드백'을 찾을 수 없습니다
      //    (훑는 날 대부분이 아직 안 쓴 날이라서).
      match /cornellNotes/{nId} {
        allow get: if signedIn() && (
          isAdmin()
          || ownsClass(cId)
          || nId.split('_')[0] == uid()
          || resource.data.uid == uid()
        );
        // 목록으로 받을 때는 문서가 반드시 있으므로 지금까지대로.
        // (교사의 '그날 반 전체' · 학생의 '내 지난 노트' 두 질의가 여기 걸립니다)
        allow list: if signedIn() && (
          isAdmin()
          || ownsClass(cId)
          || resource.data.uid == uid()
        );
        allow create: if signedIn()
                      && isClassMember(cId)
                      && isMyCornellNote(cId, nId)
                      && !('feedback' in request.resource.data);
        allow update: if signedIn()
                      && isClassMember(cId)
                      && isMyCornellNote(cId, nId)
                      && request.resource.data.get('feedback', '')
                         == resource.data.get('feedback', '')
                      // 하이라이트도 피드백과 같이 학생이 못 건드립니다.
                      // 학생이 그 대목을 고쳐 표시가 **안 그려지는 것**과
                      // 표시를 **지워 버리는 것**은 다른 일입니다 — 앞의 것은
                      // 화면이 글자를 맞춰 보고 스스로 접는 것이고, 뒤의 것은
                      // 선생님이 짚어 둔 자리를 없애는 것입니다.
                      && request.resource.data.get('feedbackMarks', [])
                         == resource.data.get('feedbackMarks', [])
                      // '이 노트를 읽고 과일을 줬다'는 도장도 선생님 것입니다.
                      // 학생이 지우면 교사 화면의 초록 표시가 없어져, 이미
                      // 준 학생에게 한 번 더 주게 됩니다.
                      && request.resource.data.get('rewardedAt', null)
                         == resource.data.get('rewardedAt', null)
                      && request.resource.data.get('rewardedBy', '')
                         == resource.data.get('rewardedBy', '');
        // 선생님의 피드백 — 그 칸만. 본문에는 손이 닿지 않습니다.
        // feedbackMarks는 '어느 대목에 준 피드백인가'를 적어 둔 자리입니다
        // ({ start, end, text } 목록 — 글자 자리와 그때의 글자). 학생 화면도
        // 이 값으로 같은 대목을 칠하므로, 교사가 짚은 자리가 그대로 보입니다.
        // **목록 안 항목의 모양까지는 규칙이 못 봅니다**(규칙 언어에 반복이
        // 없습니다). 쓸 수 있는 사람이 담당 교사뿐이라 개수 천장만 둡니다.
        // `rewardedAt`·`rewardedBy`는 '이 노트를 읽고 과일을 줬다'는 도장입니다.
        // 수업 노트 화면의 과일 단추만 찍습니다 — 교사 화면이 '피드백을 쓴 날에
        // 이 노트를 보고 과일을 줬나'로 자리 색을 가르는 데 씁니다. 지급 이력
        // (rewardEvents)에는 어느 화면에서 줬는지가 안 남아서, 답을 노트에
        // 함께 적어 둡니다(그 화면이 이미 읽고 있는 문서라 읽기가 안 늡니다).
        // **feedback을 get으로 봅니다** — 피드백보다 과일을 먼저 주면 그 칸이
        // 아직 없어서, 없는 필드를 그대로 읽으면 규칙이 평가 오류로 끝납니다.
        allow update: if (isAdmin() || ownsClassEditable(cId))
                      && changedOnly(['feedback', 'feedbackAt', 'feedbackBy', 'feedbackMarks',
                                      'rewardedAt', 'rewardedBy'])
                      && request.resource.data.get('feedback', '') is string
                      && request.resource.data.get('feedback', '').size() <= 2000
                      && request.resource.data.get('feedbackMarks', []) is list
                      && request.resource.data.get('feedbackMarks', []).size() <= 40;
        allow delete: if signedIn() && (resource.data.uid == uid() || isAdmin());
      }

      // ── 참여 전광판 자리표 ─────────────────────────────────
      //  · default: 수업 준비에서 만든 기본 자리표
      //  · daily_YYYY-MM-DD: 발표 중 임시 이동한 당일 자리표
      match /seatLayouts/{layoutId} {
        // 읽기는 그 반 학생에게도 엽니다 — 공부방 머리줄의 '자리 배치'가
        // 이 문서를 열어 자기 자리를 보여 줍니다(components/MySeatModal.jsx).
        // 새로 드러나는 것은 '누가 어디 앉는가'뿐입니다: 자리표에는 uid만
        // 들어 있고 이름·학번은 users에서 따로 읽는데, 그쪽은 이미 급우끼리
        // 열려 있습니다(isClassmateOf). 게다가 교실에 들어서면 어차피 보이는
        // 사실입니다. isClassMember는 보관된 반을 함께 막아 줍니다.
        // **쓰기는 그대로 교사만** — 자리를 정하는 것은 선생님입니다.
        allow read: if signedIn() && (isAdmin() || ownsClass(cId) || isClassMember(cId));
        allow create, update: if signedIn()
                              && (isAdmin() || ownsClassEditable(cId))
                              && request.resource.data.classId == cId
                              && request.resource.data.layoutId == layoutId
                              && request.resource.data.seats is list
                              && request.resource.data.seats.size() <= 30;
        allow delete: if signedIn() && (isAdmin() || ownsClassEditable(cId));
      }

      // ── 참여 전광판 기본 모둠 구성 ─────────────────────────
      //  · 반 단위 장기 모둠입니다. 참여 전광판의 모둠별 보기에서만 씁니다.
      match /groupAssignments/{assignmentId} {
        // 읽기는 그 반 학생에게도 엽니다 — 공부방 머리줄의 '우리 모둠'이
        // 이 문서 하나를 열어 모둠원 명단을 보여 줍니다. 여기 든 것은
        // 이름·학번·이모지뿐이고, 그건 이미 급우끼리 열려 있습니다
        // (isClassmateOf). 모둠은 교실에서 눈으로 보이는 사실이기도 합니다.
        // 쓰기는 그대로 교사만 — 모둠을 짜는 것은 선생님입니다.
        allow read: if signedIn() && (isAdmin() || ownsClass(cId) || isClassMember(cId));
        allow create, update: if signedIn()
                              && (isAdmin() || ownsClassEditable(cId))
                              && assignmentId == 'default'
                              && request.resource.data.classId == cId
                              && request.resource.data.groups is list
                              && request.resource.data.groups.size() <= 6;
        allow delete: if signedIn() && (isAdmin() || ownsClassEditable(cId));
      }

      // ── 간편 메신저 ─────────────────────────────────────────
      //  · 방은 둘 — `dm_<학생 uid>`(그 학생 ↔ 담당 선생님) · `grp_<모둠 id>`
      //    (기본 모둠의 모둠원 + 선생님). 학생끼리의 1:1은 없습니다(모둠 메모가
      //    그 자리입니다).
      //  · 담당 교사는 반의 모든 방을 읽습니다 — 창에 '선생님이 볼 수 있다'를
      //    적어 둡니다. 학생은 제 1:1 방과 **제가 든 모둠의 방**만.
      //  · 말은 못 고칩니다. 지우는 것은 담당 교사만.
      //  · 셈은 lib/messenger.js, 읽고 쓰기는 lib/data/messenger.js.
      function chatRoomGroups(cId) {
        return get(/databases/$(database)/documents/classes/$(cId)/groupAssignments/default).data.get('groups', []);
      }
      // 모둠은 최대 6개(위 groupAssignments 규칙) — 반복이 없어 여섯 번 펼칩니다.
      function chatGroupAt(gs, i, room) {
        return gs.size() > i
               && room == 'grp_' + gs[i].get('id', '')
               && gs[i].get('memberUids', []).hasAny([uid()]);
      }
      function inMyChatGroupIn(gs, room) {
        return chatGroupAt(gs, 0, room) || chatGroupAt(gs, 1, room) || chatGroupAt(gs, 2, room)
               || chatGroupAt(gs, 3, room) || chatGroupAt(gs, 4, room) || chatGroupAt(gs, 5, room);
      }
      function inMyChatGroup(cId, room) {
        return room is string && room.matches('grp_.+')
               && exists(/databases/$(database)/documents/classes/$(cId)/groupAssignments/default)
               && inMyChatGroupIn(chatRoomGroups(cId), room);
      }
      function chatShapeOk(cId) {
        let d = request.resource.data;
        return d.keys().hasOnly(['classId', 'room', 'fromUid', 'fromName', 'fromRole', 'text', 'html', 'quote', 'at'])
               && d.classId == cId
               && d.fromUid == uid()
               && d.at == request.time
               && d.text is string && d.text.size() > 0 && d.text.size() <= 1000
               // 서식 글(선택) — 앱이 정화한 HTML. 천장은 lib/messenger.js의 CHAT_HTML_MAX
               && (!('html' in d) || (d.html is string && d.html.size() <= 4000))
               // 인용 답장(선택) — 말풍선에서 끌어 고른 문장의 사본 { id, name, text }.
               // 천장은 lib/messenger.js의 CHAT_QUOTE_MAX · CHAT_NAME_MAX와 같아야 합니다.
               && (!('quote' in d)
                   || (d.quote is map
                       && d.quote.keys().hasOnly(['id', 'name', 'text'])
                       && d.quote.id is string && d.quote.id.size() > 0 && d.quote.id.size() <= 40
                       && d.quote.text is string && d.quote.text.size() > 0 && d.quote.text.size() <= 200
                       && (!('name' in d.quote) || (d.quote.name is string && d.quote.name.size() <= 40))))
               && d.fromName is string && d.fromName.size() <= 40
               && d.room is string && d.room.size() <= 80;
      }
      match /chatMessages/{mId} {
        allow read: if signedIn()
                    && (ownsClass(cId)
                        || (isClassMember(cId)
                            && (resource.data.room == 'dm_' + uid()
                                || inMyChatGroup(cId, resource.data.room))));
        allow create: if signedIn() && chatShapeOk(cId)
                      && ((ownsClassEditable(cId)
                           && request.resource.data.fromRole == 'teacher'
                           && (request.resource.data.room.matches('dm_.+')
                               || request.resource.data.room.matches('grp_.+')))
                          || (isClassMember(cId)
                              && request.resource.data.fromRole == 'student'
                              && (request.resource.data.room == 'dm_' + uid()
                                  || inMyChatGroup(cId, request.resource.data.room))));
        allow update: if false;
        allow delete: if signedIn() && ownsClassEditable(cId);
      }
      // 방마다 '누가 어디까지 읽었나' — { [uid]: 서버 시각 ms }. 말풍선의 '읽음'
      // 표시가 읽습니다. 그 방을 읽을 수 있는 사람(담당 교사 · 1:1의 학생 · 그 모둠원)이
      // 읽고, 쓰는 것은 **제 칸 하나만**(남의 칸을 고치거나 지울 수 없음).
      // 위 chatReads(내 방 전체의 표시 — 안 읽은 수)와 따로 둔 까닭: 그 문서는 내
      // 모든 방의 표시라 모둠 친구에게 열면 선생님과의 1:1을 언제 봤는지까지 드러납니다.
      function chatRoomOpen(cId, room) {
        return ownsClass(cId)
               || (isClassMember(cId) && (room == 'dm_' + uid() || inMyChatGroup(cId, room)));
      }
      match /chatRoomReads/{rId} {
        allow read: if signedIn() && chatRoomOpen(cId, rId);
        allow create: if signedIn() && chatRoomOpen(cId, rId)
                      && request.resource.data.keys().hasOnly([uid()])
                      && request.resource.data[uid()] is number;
        allow update: if signedIn() && chatRoomOpen(cId, rId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([uid()])
                      && request.resource.data[uid()] is number
                      && request.resource.data.size() <= 60;
        allow delete: if false;
      }
      // 읽음 표시 — 사람마다 한 장, 본인만. { rooms: { [방]: ms }, updatedAt }
      match /chatReads/{rUid} {
        allow read: if signedIn() && rUid == uid();
        allow create, update: if signedIn() && rUid == uid()
                              && (ownsClass(cId) || isClassMember(cId))
                              && request.resource.data.keys().hasOnly(['rooms', 'updatedAt'])
                              && request.resource.data.rooms is map
                              && request.resource.data.rooms.size() <= 80;
        allow delete: if false;
      }
    }

    // ── 입장 코드 — 문서 ID가 코드 자체. 코드 소유 교사만 관리. ──
    //  · get : 정확한 코드를 아는 사람만 1건 읽기(학생 입장 시)
    //  · list: 최고 관리자 또는 코드 개설 교사만(쿼리를 createdBy로 제한해야 함)
    //  · 생성: 최고 관리자 또는 개설 교사(보관된 반은 발급 불가)
    //  · 수정/삭제: 최고 관리자 또는 개설 교사(보관 시 코드를 지우는 데 필요)
    match /joinCodes/{code} {
      // 로그인한 사람은 누구나 '정확한 코드로 1건' 읽을 수 있습니다 — 학생이
      // 반을 찾는 길이고, 교사가 새 코드가 겹치는지 볼 때도 씁니다.
      // 목록(list)은 막혀 있어 코드를 모르면 찾을 수 없습니다.
      allow get: if signedIn();
      allow list: if isAdmin() || resource.data.createdBy == uid();
      // 자기가 개설한 반의 코드만 만들 수 있습니다. createdBy만 검사하면
      // 다른 교사의 반(classId는 로그인만 하면 조회 가능)으로 유효한 코드를
      // 위조해 학생을 남의 반에 가입시킬 수 있었습니다.
      allow create: if isAdmin()
                    || (isTeacher()
                        && request.resource.data.createdBy == uid()
                        && ownsClassEditable(request.resource.data.classId));
      allow update, delete: if isAdmin()
                            || (isTeacher() && resource.data.createdBy == uid());
    }

    // ── 소속(멤버십) — 본인 것 + 그 반 소유 교사/관리자 + 같은 반 학생(읽기만). ──
    match /memberships/{mId} {
      // isClassMember 갈래 — 공부방에서 같은 반 급우 uid 명단을 보려면
      // 학생도 그 반 소속 memberships를 나열할 수 있어야 합니다(rewards의
      // isClassMember(resource.data.classId) 패턴과 동일).
      allow read: if signedIn() && (
        resource.data.uid == uid() || isAdmin() || ownsClass(resource.data.classId)
        || isClassMember(resource.data.classId)
      );
      // 소속을 얻는 길은 둘입니다.
      //  · 학생 본인: 참여 코드(code)를 함께 적어 직접 만듭니다. 규칙이
      //    joinCodes/{code}를 get()해 **그 코드가 이 반의 것이고 만료 전인지**
      //    확인합니다 — 화면을 거치지 않고 써도 맞는 코드 없이는 못 들어옵니다.
      //    (틀린 횟수 잠금은 없습니다 — Cloud Functions 없이 배포하려고 걷음.)
      //  · **담당 교사**: 학생 프로필의 '반 편성'에서 자기 반에 직접 넣습니다
      //    (코드를 잘못 눌러 옆 반에 들어간 학생을 바로잡는 길). **자기가 개설한
      //    반에만**(ownsClassEditable) 넣을 수 있고, 보관된 반은 막힙니다.
      //  · 한 학생이 여러 반에 속할 수 있습니다(다른 반 코드로 또 들어오면 됨).
      allow create: if signedIn()
                    && request.resource.data.uid is string
                    && mId == (request.resource.data.uid + '_' + request.resource.data.classId)
                    && (
                      isAdmin() || ownsClassEditable(request.resource.data.classId)
                      || (request.resource.data.uid == uid()
                          && request.resource.data.get('code', '') is string
                          && request.resource.data.get('code', '') != ''
                          && exists(/databases/$(database)/documents/joinCodes/$(request.resource.data.code))
                          && get(/databases/$(database)/documents/joinCodes/$(request.resource.data.code)).data.classId == request.resource.data.classId
                          && get(/databases/$(database)/documents/joinCodes/$(request.resource.data.code)).data.expiresAt > request.time)
                    );
      // 학생 본인의 직접 '반 나가기'는 허용하지 않습니다. 소속 변경은
      // 담당 교사/관리자가 관리합니다.
      allow delete: if signedIn() && (
        isAdmin() || ownsClassEditable(resource.data.classId)
      );
    }

    // ── 학생 보상(과일) — 반 소유 교사/관리자만 쓰기, 읽기는 소속 학생도. ──
    //  · 문서 ID = `{classId}_{uid}`. 문서엔 uid·과일 수·이름표만(공부방은 실명 공간).
    //  · 20개마다 별(⭐)로 접어 표시 — 상한 100(별 5개).
    match /rewards/{rId} {
      allow read: if isAdmin()
                  || ownsClass(resource.data.classId)
                  || isClassMember(resource.data.classId);
      allow create, update: if (isAdmin() || ownsClassEditable(request.resource.data.classId))
                   && request.resource.data.count is int
                   && request.resource.data.count >= 0
                   && request.resource.data.count <= 100
                   && rId == (request.resource.data.classId + '_' + request.resource.data.uid);
      allow delete: if isAdmin() || ownsClassEditable(resource.data.classId);
      // 학생이 제 과일을 바꾸는 길은 과일 바구니뿐입니다 — **내놓으면** 줄고
      // 줄어든 만큼 같은 묶음에서 제 바구니가 늘어야 하며, **기부를 취소하면**
      // 늘고 늘어난 만큼 제 바구니가 줄어야 합니다(바구니 쪽 규칙이 응모 전에만
      // 줄이게 막습니다). 천장 100은 교사 쓰기와 같습니다
      // (classes/{cId}/fruitBasket 규칙과 짝).
      allow update: if signedIn()
                    && resource.data.uid == uid()
                    && rId == (resource.data.classId + '_' + uid())
                    && isClassMember(resource.data.classId)
                    && changedOnly(['count', 'updatedAt'])
                    && request.resource.data.count is int
                    && request.resource.data.count >= 0
                    && request.resource.data.count <= 100
                    && request.resource.data.count != resource.data.count
                    && fruitBasketGainMatches(resource.data.classId, uid(),
                         resource.data.count - request.resource.data.count);
    }

    // ── 수업 자료(수업하기) — 만든 선생님 본인만. 학생은 읽지 않습니다. ──
    //  · 슬라이드 이미지 URL과 장별 메모를 담습니다. 메모는 교사 전용이라
    //    학생에게 절대 노출되면 안 되므로 읽기를 소유 교사로 좁힙니다.
    //  · 학생이 수업 중 보는 슬라이드는 방송 문서(broadcasts)에 실린
    //    '현재 장 이미지 URL' 하나뿐입니다.
    match /lessons/{lId} {
      allow read: if isAdmin() || (isTeacher() && resource.data.ownerId == uid());
      allow create: if isTeacher() && request.resource.data.ownerId == uid();
      allow update, delete: if isAdmin()
                            || (isTeacher() && resource.data.ownerId == uid());
    }

    // ── 프로젝트 원본 — 반에 안 묶인 선생님의 프로젝트 ──
    //  · 수업 자료(lessons)와 같은 모양: 만든 선생님만 읽고 쓰고 지웁니다.
    //    학생은 원본을 볼 일이 없습니다 — 학생이 보는 것은 반에 만들어진
    //    복사본(studyBoards)이고, 그쪽 규칙은 그대로입니다.
    //  · 주인을 바꾸지 못합니다(ownerId 불변). 바꿀 수 있으면 원본을 남의
    //    목록에 밀어 넣을 수 있습니다. 수업 자료에는 없는 한 줄입니다.
    //  · 목록 질의는 `where ownerId == 나`여야 통과합니다(list 규칙은 결과가
    //    아니라 질의로 판정) — lib/store.js의 subscribeMyStudyTemplates가 그렇게 겁니다.
    match /studyTemplates/{tId} {
      allow read: if isAdmin() || (isTeacher() && resource.data.ownerId == uid());
      allow create: if isTeacher() && request.resource.data.ownerId == uid();
      allow update: if isAdmin()
                    || (isTeacher()
                        && resource.data.ownerId == uid()
                        && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if isAdmin() || (isTeacher() && resource.data.ownerId == uid());
    }

    // ── 발표 강제 전환(방송) — 문서 ID = classId. 있으면 방송 중, 없으면 아님. ──
    //  · 반 소유 교사/관리자만 켜고 끌 수 있고, 그 반 소속 학생은 읽기만.
    //  · 문서 ID가 곧 classId라 get() 없이 바로 판정합니다.
    match /broadcasts/{classId} {
      allow read: if isAdmin() || ownsClass(classId) || isClassMember(classId);
      allow create, update, delete: if isAdmin() || ownsClassEditable(classId);
    }

    // ── 참여 상태 — 발표 중 학생 화면이 보이는지(교사 전광판용) ──
    //  · 문서 ID = `{uid}_{classId}`. 학생은 자기 것만 쓰고, 읽기는 담당 교사만.
    //  · 화면이 보이는지(visible)와 갱신 시각뿐이라 실명·내용은 담지 않습니다.
    match /presence/{pId} {
      allow read: if isAdmin() || ownsClass(resource.data.classId);
      allow create, update: if signedIn()
                            && request.resource.data.uid == uid()
                            && pId == (uid() + '_' + request.resource.data.classId)
                            && request.resource.data.visible is bool
                            && isClassMember(request.resource.data.classId);
      allow delete: if isAdmin()
                    || resource.data.uid == uid()
                    || ownsClassEditable(resource.data.classId);
    }

    // ── 누가기록(학생 관찰 메모) — 반 소유 교사/관리자 전용 (학생 열람 불가) ──
    match /studentNotes/{noteId} {
      allow read: if isAdmin()
                  || (resource.data.classId != null && ownsClass(resource.data.classId));
      allow create: if (isAdmin()
                        || (request.resource.data.classId != null
                            && ownsClassEditable(request.resource.data.classId)))
                    && request.resource.data.teacherId == uid()
                    && request.resource.data.studentUid is string;
      allow update, delete: if isAdmin()
                            || (resource.data.classId != null && ownsClassEditable(resource.data.classId));
    }

    // ── 공부방 보드 — 읽기는 로그인 사용자(메타데이터), 쓰기는 반 소유 교사/관리자 ──
    match /studyBoards/{bId} {
      allow read: if signedIn();
      allow create: if isAdmin()
                    || (isTeacher() && ownsClassEditable(request.resource.data.classId));
      allow update, delete: if isAdmin() || ownsClassEditable(resource.data.classId);

      match /cards/{cardId} {
        // 읽기 — 본인 카드(0 get, 최우선) / 관리자 / 반 소유 교사 / 반 멤버.
        // 단, 모둠 보드가 '자기 모둠만'(private)일 때 반 멤버는 자기 모둠
        // 카드만 읽을 수 있음(memberUids array-contains 쿼리로 접근).
        // '함께 보기'(shared)면 다른 모둠 카드도 읽기 가능(수정은 불가).
        allow read: if signedIn() && (
          resource.data.authorId == uid()
          || isAdmin()
          || ownsBoard(bId)
          || (isBoardClassMember(bId)
              && (
                   !isGroupBoard(bId)
                   || isSharedBoard(bId)
                   || isMyGroupCard()
                 ))
        );
        // 생성 — 관리자/소유 교사는 자유(모둠 카드도 교사가 생성. 단, 보관 중엔 불가).
        //   학생은 (문서ID=uid) + 반 멤버 + 잠금 아님 + notice 아님 + 모둠 보드 아님.
        allow create: if signedIn()
                      && request.resource.data.authorId == uid()
                      && (
                           isAdmin()
                           || ownsBoardEditable(bId)
                           || (cardId == uid()
                               && isBoardClassMember(bId)
                               && !isBoardLocked(bId)
                               && !isNoticeBoard(bId)
                               && !isGroupBoard(bId))
                         );
        // 수정 — 관리자/소유 교사(보관 중엔 불가), 본인 카드(작성자 불변·멤버·
        //   잠금 아님·notice 아님), 또는 내 모둠 카드(내용 필드만 — 모둠
        //   명단·대표·작성자는 교사만 변경).
        allow update: if signedIn() && (
          isAdmin()
          || ownsBoardEditable(bId)
          // changedOnly를 두는 이유: 이 갈래가 없으면 본인 카드는 필드 제한이
          // 전혀 없어, 반응 필드(thumbsUpIds 등)를 자기 손으로 조작해 스스로에게
          // 반응을 주거나 남의 uid를 끼워 넣어 수를 부풀릴 수 있었습니다.
          || (cardId == uid()
              && request.resource.data.authorId == resource.data.authorId
              && isBoardClassMember(bId)
              && !isBoardLocked(bId)
              && !isNoticeBoard(bId)
              && changedOnly(['title','content','imageUrl','attachments','updatedAt']))
          || (isMyGroupCard()
              && isBoardClassMember(bId)
              && !isBoardLocked(bId)
              && changedOnly(['title','content','imageUrl','attachments','updatedAt']))
          // 카드에 다는 작은 반응(엄지 척/하트/웃는 얼굴) — questions/answers의
          // 반응과 같은 이유·같은 방식입니다. 자기 카드(모둠 카드는 자기 모둠의
          // 카드)에는 반응할 수 없고, 잠금(editMode) 여부와는 무관합니다 —
          // 반응은 제출물을 고치는 게 아니라 남의 결과물에 다는 가벼운
          // 응원이라 '보기 전용' 기간에도 계속 남길 수 있어야 합니다.
          || (isBoardClassMember(bId)
              && (isGroupBoard(bId) ? !isMyGroupCard() : resource.data.authorId != uid())
              && changedOnly(['thumbsUpIds'])
              && isOwnReactionToggle('thumbsUpIds'))
          || (isBoardClassMember(bId)
              && (isGroupBoard(bId) ? !isMyGroupCard() : resource.data.authorId != uid())
              && changedOnly(['heartIds'])
              && isOwnReactionToggle('heartIds'))
          || (isBoardClassMember(bId)
              && (isGroupBoard(bId) ? !isMyGroupCard() : resource.data.authorId != uid())
              && changedOnly(['smileIds'])
              && isOwnReactionToggle('smileIds'))
        );
        // 삭제 — 관리자 또는 반 소유 교사만(보관 중엔 불가). 학생은 자기
        //   카드도 수정만 가능하고 삭제는 못 합니다(실수로 지운 제출물을
        //   되살릴 방법이 없어 삭제 권한을 교사에게만 둡니다).
        allow delete: if signedIn() && (isAdmin() || ownsBoardEditable(bId));
      }
    }

    // ── 책방 활동 — 닿소리 채우기 (반별) ──────────────────────
    //  · 활동 문서: 반 구성원 읽기, 반 소유 교사/관리자만 쓰기
    //  · 모둠 메타: 반 구성원 모두 읽기(대시보드에 전체 모둠 카드 표시).
    //      쓰기는 교사(구성) + 자유 구성 모드의 학생 본인(참여/나가기)만.
    //  · 단어: 그 모둠원과 담당 교사만 읽기 — 활동 중 남의 모둠 단어를
    //      훔쳐보지 못하게 모둠 메타와 분리해 둔 컬렉션입니다.
    function bookActivityClassId(aId) {
      return get(/databases/$(database)/documents/bookActivities/$(aId)).data.classId;
    }
    function ownsBookActivity(aId) {
      return ownsClass(bookActivityClassId(aId));
    }
    function ownsBookActivityEditable(aId) {
      return ownsClassEditable(bookActivityClassId(aId));
    }
    function isBookActivityMember(aId) {
      return isClassMember(bookActivityClassId(aId));
    }
    function isBookActivityFree(aId) {
      return get(/databases/$(database)/documents/bookActivities/$(aId)).data.get('groupMode', 'teacher') == 'free';
    }
    function isBookActivitySolo(aId) {
      return get(/databases/$(database)/documents/bookActivities/$(aId)).data.get('groupMode', 'teacher') == 'solo';
    }
    function isBookActivityLocked(aId) {
      return get(/databases/$(database)/documents/bookActivities/$(aId)).data.get('locked', false) == true;
    }
    // 열 개의 해시태그 — 교사가 '공개하기'를 눌렀나. 표시가 없으면 공개 전.
    function isBookActivityPublished(aId) {
      return get(/databases/$(database)/documents/bookActivities/$(aId)).data.get('published', false) == true;
    }
    // 내가 이 모둠의 구성원인지 (단어 읽기/쓰기 판정)
    function isMyBookGroup(aId, gId) {
      return get(/databases/$(database)/documents/bookActivities/$(aId)/groups/$(gId))
               .data.get('memberUids', []).hasAny([uid()]);
    }

    match /bookActivities/{aId} {
      // 문서 자신에 classId가 있으므로 get() 없이 바로 판정합니다.
      allow read: if signedIn() && (
        isAdmin()
        || ownsClass(resource.data.classId)
        || isClassMember(resource.data.classId)
      );
      allow create: if isAdmin()
                    || (isTeacher() && ownsClassEditable(request.resource.data.classId));
      allow update, delete: if isAdmin() || ownsClassEditable(resource.data.classId);

      match /groups/{gId} {
        // 모둠 카드는 반 구성원 모두에게 공개 (누가 어느 모둠인지 확인)
        allow read: if signedIn() && (isAdmin() || ownsBookActivity(aId) || isBookActivityMember(aId));
        allow create, delete: if isAdmin() || ownsBookActivityEditable(aId);
        // 수정 — 교사는 자유롭게(보관 중엔 불가). 학생은 두 가지만:
        //   ① '자유 구성' 모드에서 자기 자신만 명단에 넣고 빼기(다른 필드 불가)
        //   ② '개별 활동'에서 자기 판의 주제어(topic) 적기 — 판 하나가 곧 한
        //      사람이라, 읽는 책이 저마다 다를 수 있어 학생이 직접 적습니다.
        //      구성원 판정은 이 문서의 memberUids로 바로 합니다(get 추가 없음).
        //      낱말과 달리 '남의 글로 둔갑'할 수 있는 값이 아니고, 고칠 수 있는
        //      범위가 자기 판 하나로 끝납니다.
        allow update: if isAdmin()
                      || ownsBookActivityEditable(aId)
                      || (signedIn()
                          && isBookActivityMember(aId)
                          && isBookActivityFree(aId)
                          && changedOnly(['memberUids','members'])
                          && request.resource.data.memberUids.toSet()
                               .difference(resource.data.memberUids.toSet()).hasOnly([uid()])
                          && resource.data.memberUids.toSet()
                               .difference(request.resource.data.memberUids.toSet()).hasOnly([uid()]))
                      || (signedIn()
                          && changedOnly(['topic'])
                          && resource.data.get('memberUids', []).hasAny([uid()])
                          && isBookActivitySolo(aId)
                          && !isBookActivityLocked(aId)
                          && request.resource.data.topic is string
                          && request.resource.data.topic.size() <= 40);

        match /words/{wId} {
          // 단어는 그 모둠원과 담당 교사만 — 다른 모둠에는 보이지 않습니다.
          allow read: if signedIn() && (isAdmin() || ownsBookActivity(aId) || isMyBookGroup(aId, gId));
          allow create: if signedIn()
                        && request.resource.data.authorId == uid()
                        && isMyBookGroup(aId, gId)
                        && !isBookActivityLocked(aId);
          // 지우기는 본인이 넣은 단어 또는 담당 교사(보관 중엔 교사도 불가)
          allow delete: if signedIn() && (
            isAdmin() || ownsBookActivityEditable(aId)
            || (resource.data.authorId == uid() && !isBookActivityLocked(aId))
          );
        }

        // ── 가로세로 낱말퀴즈(모둠) — 모둠이 맡은 낱말과 힌트 ──
        // 문서 하나 = 낱말 하나. 낱말(정답)이 들어 있어 낱말 문서처럼 그 모둠과
        // 담당 교사만 읽습니다. 만들고 지우는 것은 교사('생성'·'내리기').
        // 학생은 두 가지만 고칩니다:
        //   ① 쓸 사람(알약) — 힌트가 비어 있을 때, 또는 지금 쓰는 사람 자신이.
        //      남이 쓴 힌트의 이름표를 갈아 끼우면 '누가 썼나'가 거짓이 됩니다.
        //      고른 사람은 그 모둠 구성원이어야 합니다(null은 비우기).
        //   ② 힌트 글 — 알약이 가리키는 그 학생만, 100자까지
        //      (lib/crossword.js의 CROSSWORD_HINT_MAX와 같아야 합니다).
        match /xwHints/{hId} {
          function groupMemberUids() {
            return get(/databases/$(database)/documents/bookActivities/$(aId)/groups/$(gId)).data.get('memberUids', []);
          }
          allow read: if signedIn() && (isAdmin() || ownsBookActivity(aId) || isMyBookGroup(aId, gId));
          allow create, delete: if isAdmin() || ownsBookActivityEditable(aId);
          allow update: if isAdmin() || ownsBookActivityEditable(aId) || (
            signedIn()
            && groupMemberUids().hasAny([uid()])
            && !isBookActivityLocked(aId)
            && (
              (changedOnly(['writerUid','writerName','updatedAt'])
                && (resource.data.get('hint', '') == '' || resource.data.get('writerUid', null) == uid())
                && (request.resource.data.writerUid == null
                    || groupMemberUids().hasAny([request.resource.data.writerUid]))
                && request.resource.data.writerName is string
                && request.resource.data.writerName.size() <= 40)
              || (changedOnly(['hint','updatedAt'])
                && resource.data.get('writerUid', null) == uid()
                && request.resource.data.hint is string
                && request.resource.data.hint.size() <= 100)
            )
          );
        }

        // ── 가로세로 낱말퀴즈(모둠) — 모둠이 함께 채우는 판 ──
        // 문서 하나(main)에 칸 맵 하나. 모둠원이 칸 하나씩 merge로 써서 동시에
        // 다른 낱말을 넣어도 서로 덮지 않습니다. 교사는 읽기와 걷기만.
        match /xwBoard/{bId} {
          allow read: if signedIn() && (isAdmin() || ownsBookActivity(aId) || isMyBookGroup(aId, gId));
          allow create, update: if signedIn()
                        && bId == 'main'
                        && isMyBookGroup(aId, gId)
                        && !isBookActivityLocked(aId)
                        && request.resource.data.keys().hasOnly(['cells','updatedAt'])
                        && request.resource.data.cells is map
                        && request.resource.data.cells.size() <= 600;
          allow delete: if isAdmin() || ownsBookActivityEditable(aId);
        }

        // 누가 맞혔나 — 낱말 하나에 한 장(문서 id = 낱말 차례). 그 낱말을 끝까지
        // 채워 맞힌 모둠원이 제 이름으로 **한 번만** 만듭니다(고치기 없음 —
        // 먼저 맞힌 사람이 남음). 교사의 '모둠별 풀이' 팝오버 정답 탭이 읽습니다.
        match /xwSolves/{sId} {
          allow read: if signedIn() && (isAdmin() || ownsBookActivity(aId) || isMyBookGroup(aId, gId));
          allow create: if signedIn()
                        && isMyBookGroup(aId, gId)
                        && !isBookActivityLocked(aId)
                        && request.resource.data.keys().hasOnly(['idx','uid','name','at'])
                        && request.resource.data.uid == uid()
                        && request.resource.data.idx is int
                        && string(request.resource.data.idx) == sId
                        && request.resource.data.name is string
                        && request.resource.data.name.size() <= 40
                        && request.resource.data.at == request.time;
          allow delete: if isAdmin() || ownsBookActivityEditable(aId);
        }

        // ── 브레인 라이팅 — 컬럼(주인)마다 모둠원이 한 줄씩 ──
        // 문서 id = 주인uid_쓴사람uid — 한 사람이 한 컬럼에 한 줄.
        // [읽기] 그 모둠 · 담당 교사  [쓰기] 그 모둠원이 제 줄만 · 주인도 이 모둠원 · 잠기기 전
        // [지우기] 담당 교사
        match /bwNotes/{nId} {
          allow read: if signedIn() && (isAdmin() || ownsBookActivity(aId) || isMyBookGroup(aId, gId));
          allow create, update: if signedIn()
                        && isMyBookGroup(aId, gId)
                        && !isBookActivityLocked(aId)
                        && request.resource.data.keys().hasOnly(['ownerUid','writerUid','writerName','text','updatedAt'])
                        && request.resource.data.writerUid == uid()
                        && request.resource.data.ownerUid is string
                        && nId == request.resource.data.ownerUid + '_' + uid()
                        && get(/databases/$(database)/documents/bookActivities/$(aId)/groups/$(gId))
                             .data.get('memberUids', []).hasAny([request.resource.data.ownerUid])
                        && request.resource.data.writerName is string
                        && request.resource.data.writerName.size() <= 40
                        && request.resource.data.text is string
                        && request.resource.data.text.size() <= 1000
                        && request.resource.data.updatedAt == request.time;
          allow delete: if isAdmin() || ownsBookActivityEditable(aId);
        }
      }

      // ── 가로세로 낱말퀴즈(개별 활동) — 학생마다 제 판의 요약 ──
      // 개별 활동은 판 하나가 한 사람이라 판(xwBoard)은 그 학생만 읽습니다(정답
      // 글자가 든 문서). 반 친구가 '가장 많이 채운 친구'의 미니맵을 보려면
      // 글자 없는 요약이 따로 있어야 합니다 — 칸 자리 · 맞힌 낱말 차례 · 수.
      // [읽기] 반 구성원 · 담당 교사  [쓰기] 그 판의 주인만 · 잠기기 전
      // [지우기] 담당 교사(퍼즐을 새로 만들거나 내릴 때)
      match /xwProgress/{gId} {
        allow read: if signedIn() && (isAdmin() || ownsBookActivity(aId) || isBookActivityMember(aId));
        allow create, update: if signedIn()
                      && isMyBookGroup(aId, gId)
                      && !isBookActivityLocked(aId)
                      && request.resource.data.keys().hasOnly(['groupId','uid','solved','total','cells','hintChars','filled','solvedIdx','updatedAt'])
                      && request.resource.data.groupId == gId
                      && request.resource.data.uid == uid()
                      && request.resource.data.solved is int && request.resource.data.solved >= 0 && request.resource.data.solved <= 200
                      && request.resource.data.total is int && request.resource.data.total >= 0 && request.resource.data.total <= 200
                      && request.resource.data.cells is int && request.resource.data.cells >= 0 && request.resource.data.cells <= 600
                      && request.resource.data.hintChars is int && request.resource.data.hintChars >= 0 && request.resource.data.hintChars <= 200
                      && request.resource.data.filled is list && request.resource.data.filled.size() <= 600
                      && request.resource.data.solvedIdx is list && request.resource.data.solvedIdx.size() <= 200;
        allow delete: if isAdmin() || ownsBookActivityEditable(aId);
      }

      // ── 곁텍스트 읽기 — 개인 활동 기록 ──
      // 문서 ID를 학생 uid로 고정해 '한 사람이 여러 장을 만드는 일'을 막습니다.
      // 모둠 활동과 달리 제출물이라, 남의 답은 같은 반이어도 보이지 않습니다
      // (본인과 담당 교사만). 학생 답에는 실명이 들어가므로 더 좁게 잠급니다.
      match /entries/{sId} {
        // 모둠 RAFT — 같은 모둠 친구가 이 글을 읽고 감상을 씁니다(선생님 요청).
        // 기록이 스스로 적은 모둠(groupId)에 **읽는 나와 글쓴이가 둘 다** 있어야
        // 합니다 — 글쓴이가 남의 모둠 id를 적어도 자신이 그 명단에 없으면 소용이
        // 없습니다(동료 평가의 reviewGroupHas와 같은 생각). 모둠 활동(grouped)이고
        // RAFT일 때만, 물러난 모둠은 뺍니다. 없는 문서는 판정할 모둠이 없어 거부.
        function mateReadsEntry() {
          let act = get(/databases/$(database)/documents/bookActivities/$(aId)).data;
          let gId = resource.data.get('groupId', '');
          let gPath = /databases/$(database)/documents/bookActivities/$(aId)/groups/$(gId);
          return act.get('grouped', false) == true
                 && act.get('type', '') == 'raft'
                 && gId is string && gId.size() > 0
                 && exists(gPath)
                 && get(gPath).data.get('retired', false) != true
                 && get(gPath).data.get('memberUids', []).hasAll([uid(), sId]);
        }
        allow read: if signedIn() && (
          isAdmin() || ownsBookActivity(aId) || sId == uid() || mateReadsEntry()
        );
        allow create, update: if signedIn()
                      && sId == uid()
                      && request.resource.data.authorId == uid()
                      && isBookActivityMember(aId)
                      && !isBookActivityLocked(aId);
        // 지우기는 담당 교사만 — 학생이 실수로 제출물을 통째로 날리지 못하게
        allow delete: if isAdmin() || ownsBookActivityEditable(aId);
      }

      // ── 내 생각은요... — 반 전체가 함께 쓰는 메모판 ─────────────────
      // 학생이 포스트잇 같은 메모에 제 생각을 적어 교사가 나눈 영역(찬성·
      // 반대 …) 위에 붙입니다. 한 사람이 여러 장 붙일 수 있습니다(자동 id).
      //
      // [읽기] 반 구성원 모두 — 서로의 생각을 읽는 것이 이 활동의 전부입니다
      //   (entries는 본인·교사만인 것과 반대).
      // [쓰기] 쓴 사람은 글·색·자리를, 담당 교사는 **자리만**(칠판 앞에서
      //   모아 정리) 고칩니다. 누가 썼는지(authorId·이름표·byTeacher)는 아무도
      //   못 바꿉니다. 잠긴 활동은 교사만 손댑니다.
      // [이름표] 활동의 nameMode가 정합니다 — 익명(nick: 학생이 적은 닉네임 ·
      //   studentId 없음 · anon: true)이면 반 전체가 읽는 문서에 실명이 안
      //   남고, 실명(real)이면 학번·이름을 적습니다. 학번을 적으면 아래 검사가
      //   제 학번·이름과 같은지 봅니다(옛 앱의 메모도 같은 검사). 누가 썼는지는
      //   교사가 authorId로 명단에서 찾습니다. 학생은 '선생님' 이름표를 못 씁니다.
      // 글자 수 천장 500은 lib/opinion.js의 OPINION_TEXT_MAX와 같아야 합니다.
      match /opinionNotes/{nId} {
        function validNote(d) {
          return d.text is string && d.text.size() > 0 && d.text.size() <= 500
                 && d.zone is string && d.zone.size() > 0 && d.zone.size() <= 12
                 && d.x is number && d.x >= 0 && d.x <= 1
                 && d.y is number && d.y >= 0 && d.y <= 1
                 && d.color is string && d.color.size() <= 16
                 && d.authorName is string && d.authorName.size() <= 40;
        }
        function noteIdentityOk(d) {
          let prof = get(/databases/$(database)/documents/users/$(uid())).data;
          return d.authorName != '선생님'
                 && (d.get('studentId', null) == null
                     || prof.get('studentId', null) == null
                     || (d.get('studentId', null) == prof.get('studentId', null)
                         && d.authorName == prof.get('realName', d.authorName)));
        }

        allow read: if signedIn() && (
          isAdmin() || ownsBookActivity(aId) || isBookActivityMember(aId)
        );
        allow create: if signedIn()
                      && request.resource.data.authorId == uid()
                      && validNote(request.resource.data)
                      && (
                        (isBookActivityMember(aId)
                          && !isBookActivityLocked(aId)
                          && request.resource.data.get('byTeacher', false) == false
                          && noteIdentityOk(request.resource.data))
                        || ownsBookActivityEditable(aId)
                        || isAdmin()
                      );
        allow update: if signedIn() && validNote(request.resource.data) && (
          isAdmin()
          || (resource.data.authorId == uid()
              && (isBookActivityMember(aId) || ownsBookActivityEditable(aId))
              && !isBookActivityLocked(aId)
              && changedOnly(['text','color','zone','x','y','updatedAt','movedAt']))
          || (ownsBookActivityEditable(aId)
              && changedOnly(['zone','x','y','movedAt']))
        );
        allow delete: if signedIn() && (
          isAdmin() || ownsBookActivityEditable(aId)
          || (resource.data.authorId == uid() && !isBookActivityLocked(aId))
        );
      }

      // ── 열 개의 해시태그 — 보고서 한 장 + 댓글 ─────────────────────
      // 학생이 글을 읽고 해시태그 열 개(태그 · 원문 문장 · 알 수 있는 것)와
      // 요약을 적어 보고서 한 장을 만듭니다. 문서 id가 학생 uid라 한 사람에
      // 한 장입니다.
      //
      // [읽기] 공개 전에는 **제 것만**(+ 담당 교사는 전부). 교사가 활동의
      //   `published`를 켜면 반 구성원이 서로의 보고서를 읽고 댓글을 답니다.
      //   공개를 거두면 다시 제 것만 — 댓글은 지우지 않고, 보고서 주인은 제
      //   보고서에 달린 것을 계속 읽습니다(postUid == 나).
      // [이름표] 보고서·댓글에 학번·이름을 적어 둡니다(친구 화면이 급우
      //   프로필을 따로 읽지 않게). 남의 이름으로 쓰지 못하게 '내 생각은요'의
      //   메모와 같은 검사를 합니다 — 학번이 없는 옛 계정은 견줄 수 없어 둡니다.
      // [잠금] 잠긴 활동은 고치기·새 댓글이 막힙니다. 다만 '댓글 여기까지
      //   봤다'(seenCommentsAt) 한 칸과 제 댓글 지우기는 늘 됩니다.
      // 길이 천장은 lib/hashtag.js의 HASHTAG_*_MAX와 같아야 합니다.
      function hashtagIdentityOk(d) {
        let prof = get(/databases/$(database)/documents/users/$(uid())).data;
        return prof.get('studentId', null) == null
               || (d.get('studentId', null) == prof.get('studentId', null)
                   && d.authorName == prof.get('realName', d.authorName));
      }

      match /hashtagPosts/{sId} {
        function validPost(d) {
          return d.authorId == uid()
                 && d.authorName is string && d.authorName.size() <= 40
                 && d.title is string && d.title.size() <= 80
                 && d.summary is string && d.summary.size() <= 5000
                 && d.tags is list && d.tags.size() <= 10
                 && d.source is map && d.image is map
                 && d.image.get('url', '') is string
                 && d.image.get('url', '').size() <= 2000;
        }

        // 아직 안 쓴 제 보고서를 열어 볼 때 문서가 없어도 되도록 get은 id로.
        allow get: if signedIn() && (
          isAdmin() || ownsBookActivity(aId) || sId == uid()
          || (isBookActivityMember(aId) && isBookActivityPublished(aId))
        );
        allow list: if signedIn() && (
          isAdmin() || ownsBookActivity(aId)
          || (isBookActivityMember(aId) && isBookActivityPublished(aId))
        );
        allow create: if signedIn()
                      && sId == uid()
                      && isBookActivityMember(aId)
                      && !isBookActivityLocked(aId)
                      && validPost(request.resource.data)
                      && hashtagIdentityOk(request.resource.data);
        allow update: if signedIn()
                      && sId == uid()
                      && resource.data.authorId == uid()
                      && (
                        (isBookActivityMember(aId)
                          && !isBookActivityLocked(aId)
                          && validPost(request.resource.data)
                          && hashtagIdentityOk(request.resource.data))
                        || changedOnly(['seenCommentsAt'])
                      );
        // 지우기는 담당 교사만 — 학생이 실수로 보고서를 통째로 날리지 못하게.
        allow delete: if isAdmin() || ownsBookActivityEditable(aId);
      }

      match /hashtagComments/{cId} {
        function validComment(d) {
          return d.authorId == uid()
                 && d.authorName is string && d.authorName.size() <= 40
                 && d.postUid is string && d.postUid.size() > 0 && d.postUid.size() <= 128
                 && d.kind in ['like', 'ask', 'suggest']
                 && d.text is string && d.text.size() > 0 && d.text.size() <= 500;
        }

        allow read: if signedIn() && (
          isAdmin() || ownsBookActivity(aId)
          || resource.data.postUid == uid()
          || resource.data.authorId == uid()
          || (isBookActivityMember(aId) && isBookActivityPublished(aId))
        );
        // 학생은 공개된 뒤에만 · 제 이름으로만 · '선생님' 댓글 흉내 불가.
        // 교사는 공개 전에도 답니다(보고서 주인은 제 보고서에서 읽습니다).
        allow create: if signedIn()
                      && validComment(request.resource.data)
                      && (
                        (isBookActivityMember(aId)
                          && isBookActivityPublished(aId)
                          && !isBookActivityLocked(aId)
                          && request.resource.data.get('byTeacher', false) == false
                          && hashtagIdentityOk(request.resource.data))
                        || ownsBookActivityEditable(aId)
                        || isAdmin()
                      );
        // 고치기는 없습니다 — 답이 달린 뒤 원래 글이 바뀌면 대화가 어긋납니다.
        allow update: if false;
        // 지우기는 쓴 사람과 담당 교사. **보고서 주인은 못 지웁니다** —
        // 마음에 안 드는 '제안합니다'를 주인이 걷어 내면 댓글의 뜻이 없어집니다.
        allow delete: if signedIn() && (
          isAdmin() || ownsBookActivityEditable(aId) || resource.data.authorId == uid()
        );
      }

      // ── 동료 평가 — 모둠 친구의 발표를 듣고 남기는 한 마디 ──────────
      // 문서 ID는 `받는사람_쓴사람`입니다. 한 사람이 한 친구에게 한 장만
      // 쓰고, 그 장을 고쳐 씁니다(같은 친구에게 여러 장이 쌓이면 무엇이
      // 마지막 생각인지 알 수 없습니다).
      //
      // [읽기] 받은 학생 + 쓴 학생 + 담당 교사.
      //   반 전체가 서로 다 보게 하지 않은 이유는, 먼저 쓴 코멘트를 보고
      //   따라 쓰게 되기 때문입니다. 솔직하게 쓰려면 남의 답이 안 보여야
      //   합니다. 대신 쓴 사람 이름은 남깁니다 — 익명이면 함부로 씁니다.
      //
      // [쓰기] 같은 모둠 친구에게만. 판정은 문서에 적힌 groupId 한 번의
      //   get으로 합니다 — 규칙은 모둠을 뒤져 찾을 수 없어서, 어느 모둠에서
      //   쓴 것인지 문서가 스스로 말하게 합니다. 그 모둠 명단에 **쓴 사람과
      //   받는 사람이 둘 다** 들어 있어야 통과하므로, 남의 모둠 id를 적어
      //   보내도 소용이 없습니다.
      //
      // [잠금] 활동 전체 잠금(locked)과 별개로 `peerReviewLocked`가 있습니다.
      //   수업 중 '이제 그만 쓰고 이야기하자'로 닫는 자리라, 글쓰기까지 함께
      //   잠기면 안 됩니다. 없는 값은 열린 것으로 봅니다(옛 활동).
      match /peerReviews/{rId} {
        function reviewGroupHas(gId, a, b) {
          return gId is string
                 && gId.size() > 0
                 && exists(/databases/$(database)/documents/bookActivities/$(aId)/groups/$(gId))
                 && get(/databases/$(database)/documents/bookActivities/$(aId)/groups/$(gId))
                      .data.get('memberUids', []).hasAll([a, b]);
        }
        // **표시가 없으면 잠김**입니다. 동료 평가는 '발표를 듣는 시간'에만
        // 여는 것이라, 활동을 만들자마자 열려 있으면 아직 아무도 발표하지
        // 않았는데 코멘트가 쌓입니다. 교사가 한 번 눌러 열어야 시작합니다
        // (열면 `peerReviewLocked: false`가 적힙니다).
        function peerReviewOpen() {
          return get(/databases/$(database)/documents/bookActivities/$(aId))
                   .data.get('peerReviewLocked', true) == false;
        }
        function validReview(d) {
          return d.fromUid == uid()
                 && d.toUid is string
                 && d.toUid != uid()
                 && rId == d.toUid + '_' + uid()
                 && d.html is string
                 && d.html.size() > 0
                 && d.html.size() <= 4000
                 && reviewGroupHas(d.get('groupId', ''), uid(), d.toUid);
        }

        // **같은 모둠 친구끼리는 서로 받은 평가를 봅니다**(기본값 — 선생님 요청).
        // A의 글에 B · C · D가 남긴 평가를 B · C · D도 서로 봅니다. 판정은 문서에
        // 적힌 groupId의 명단에 읽는 내가 들어 있는가(reviewGroupHas — 남의 모둠
        // id를 질의해도 그 명단에 내가 없으면 거부). **늘 그렇습니다** — 교사가 끄던
        // '모둠끼리 보기'(`peerReviewShared`)는 걷었고, 옛 활동에 남은 false도 안 봅니다.
        allow get, list: if signedIn() && (
          isAdmin()
          || ownsBookActivity(aId)
          || resource.data.toUid == uid()
          || resource.data.fromUid == uid()
          || reviewGroupHas(resource.data.get('groupId', ''), uid(), uid())
        );
        allow create: if signedIn()
                      && isBookActivityMember(aId)
                      && !isBookActivityLocked(aId)
                      && peerReviewOpen()
                      && validReview(request.resource.data);
        // 고쳐 쓰기는 쓴 사람만. 받는 사람·모둠은 못 바꿉니다(바꿀 수 있으면
        // 남에게 쓴 글을 다른 친구 것으로 옮겨 놓을 수 있습니다).
        allow update: if signedIn()
                      && !isBookActivityLocked(aId)
                      && peerReviewOpen()
                      && resource.data.fromUid == uid()
                      && request.resource.data.fromUid == resource.data.fromUid
                      && request.resource.data.toUid == resource.data.toUid
                      && request.resource.data.get('groupId', '') == resource.data.get('groupId', '')
                      && request.resource.data.html is string
                      && request.resource.data.html.size() > 0
                      && request.resource.data.html.size() <= 4000;
        // 지우기는 쓴 사람과 담당 교사. 학생이 자기 말을 거둘 수 있어야 합니다.
        allow delete: if isAdmin()
                      || ownsBookActivityEditable(aId)
                      || (signedIn() && resource.data.fromUid == uid());
      }
    }

    // ── KWL — 개인 성찰. 본인 + 반 소유 교사/관리자만. ──
    //  · 생성: 본인 명의 + 자기가 속한 반으로만 (남의 반에 기록을 심지 못하게)
    //  · 수정: 작성자·반·날짜는 못 바꿉니다 — 예전에는 본인 문서를 다른
    //    학생·다른 반 기록으로 바꿔치기할 수 있었습니다.
    //    (변경 키 화이트리스트가 아니라 '불변 필드 고정'으로 검사합니다.
    //     addKwl이 같은 문서에 merge로 다시 쓰면서 createdAt·이름표를 함께
    //     갱신하므로, 화이트리스트 방식이면 정상 재저장이 막힙니다)
    match /kwl/{kwlId} {
      allow read: if signedIn() && (
        resource.data.userId == uid() || isAdmin() || ownsClass(resource.data.classId)
      );
      // 교사는 반의 '멤버'가 아니라 '소유자'라 두 경로를 모두 열어 둡니다
      // (교사도 자기 반에서 KWL을 쓸 수 있어야 하므로. 보관 중엔 교사도 불가).
      allow create: if signedIn()
                    && request.resource.data.userId == uid()
                    && (
                         isClassMember(request.resource.data.classId)
                         || ownsClassEditable(request.resource.data.classId)
                         || isAdmin()
                       );
      allow update: if signedIn()
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.classId == resource.data.classId
                    && request.resource.data.date == resource.data.date
                    && (
                         resource.data.userId == uid()
                         || isAdmin()
                         || ownsClassEditable(resource.data.classId)
                       );
      allow delete: if signedIn() && (
        resource.data.userId == uid() || isAdmin() || ownsClassEditable(resource.data.classId)
      );
    }

    // ── 컬렉션 그룹 쿼리 규칙 ─────────────────────────────────
    // collectionGroup() 쿼리는 {path=**} 그룹 규칙이 없으면 무조건 거부됨.
    // · answers: 질문 게시판은 전체 공유라 로그인 사용자 읽기(경로 규칙과 동일 노출)
    // · cards  : 본인 카드(학생 리포트 '내 카드') / 내 모둠 카드 / 최고 관리자만.
    //   교사에게는 열지 않음 — 반(보드) 격리 유지. 쓰기는 여기 없음(경로 규칙 적용).
    match /{path=**}/answers/{aId} {
      allow read: if signedIn();
    }
    match /{path=**}/cards/{cardId} {
      allow read: if signedIn() && (
        resource.data.authorId == uid()
        || isAdmin()
        || resource.data.get('memberUids', []).hasAny([uid()])
      );
    }
  }
}
