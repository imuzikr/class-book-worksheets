      "fields": [
        {
          "fieldPath": "userId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "subscribeAllKwl — 교사 오늘 전체: classId==, date==",
      "collectionGroup": "kwl",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "classId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "date",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "pruneOldNotifications — 읽은 지 오래된 알림 정리: read==, createdAt <",
      "collectionGroup": "notifications",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "read",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "subscribeMyNotifications — 안 읽은 알림만 최신순: read==, createdAt desc",
      "collectionGroup": "notifications",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "read",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    }
  ],
  "fieldOverrides": [
    {
      "//": "subscribeMyStudyCards — 학생 리포트 내 카드: collectionGroup cards, authorId==",
      "collectionGroup": "cards",
      "fieldPath": "authorId",
      "indexes": [
