# =============================================================
# 책봄 환경변수 예시
# -------------------------------------------------------------
# 로컬: 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env.local
# Vercel: Project Settings → Environment Variables 에 같은 이름으로 넣으세요.
# 값을 비워 두면 원작자 프로젝트(book-sheets-19fd2) 기본값으로 돕니다.
#   → 복제해 쓸 때는 반드시 자기 Firebase 값을 넣으세요.
# =============================================================

# ── Firebase 웹 설정 (브라우저에 노출됩니다. 비밀이 아닙니다) ──
# Firebase 콘솔 → 프로젝트 설정(톱니) → 내 앱 → 웹 앱 → SDK 설정·구성
# 에서 확인할 수 있습니다.

# API 키 (apiKey). 자리표시자 YOUR_... 로 시작하면 데모 모드로 돕니다.
NEXT_PUBLIC_FIREBASE_API_KEY=

# 인증 도메인 (authDomain). 보통 <프로젝트ID>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

# 프로젝트 ID (projectId)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Storage 버킷 (storageBucket). 보통 <프로젝트ID>.firebasestorage.app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# 발신자 ID (messagingSenderId)
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# 앱 ID (appId). 예: 1:123456789:web:abcdef
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── 서버 전용 (Vercel에만 넣고, GitHub에는 올리지 마세요) ──
# Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성
# 독서 성장 서버 API에 씁니다. 없으면 해당 서버 기능만 꺼집니다.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# 줄바꿈은 \n 으로 한 줄에 넣거나, Vercel에서는 여러 줄로 붙여 넣으세요.
FIREBASE_ADMIN_PRIVATE_KEY=

# 선택 — 카카오 책 검색 (developers.kakao.com → 내 애플리케이션 → 앱 키의 REST API 키)
# 서버에서만 읽습니다(NEXT_PUBLIC_ 붙이지 마세요). 없으면 책 등록 때 수동 입력만 됩니다.
KAKAO_REST_API_KEY=
