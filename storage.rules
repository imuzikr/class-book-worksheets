rules_version = '2';

// =============================================================
// Firebase Storage 보안 규칙 — class-book-worksheets (책 나눔)
// -------------------------------------------------------------
// 그림 저장소. 학생·교사 그림은 **반 폴더**에만 올립니다(이미지 보안 1~5단계).
//   uploads/{classId}/{uid}/{파일명}
//  · 읽기(get): 같은 반 학생 · 그 반 담당 교사(classes.createdBy) · 관리자
//               — 다른 반 교사·학생은 못 봅니다. 목록(list)은 아무도 못 봅니다.
//  · 올리기   : 본인 uid 폴더 · 그 반 소속(또는 담당 교사) · 이미지 6MB 미만 · 덮어쓰기 금지
//  · 지우기   : 본인 · 담당 교사 · 관리자
// Firestore 문서에는 다운로드 URL 대신 "storage:uploads/…" 경로만 저장하고,
// 화면(SecureImage/SecureHtml)이 권한을 확인하며 내려받아 보여 줍니다.
//
// 옛 개인 폴더 uploads/{uid}/{파일명}는 닫혔습니다(5단계) — 새로 올릴 수 없고
// 목록도 못 봅니다. 앱에 이 폴더로 올리는 코드(수업 자료 PDF 포함)는 없습니다.
//
// 이 규칙은 반 소속·역할을 Firestore(memberships·classes·users)에서 읽습니다.
// 배포:  Firebase 콘솔 → Storage → 규칙 탭에 붙여넣고 게시
//        (또는 firebase deploy --only storage)
//        처음 게시할 때 "Firestore 접근 권한" 연결을 물으면 허용해야 합니다
//        — 거부하면 반 폴더 그림이 전부 막힙니다.
// =============================================================
service firebase.storage {
  match /b/{bucket}/o {

    function claimRole() { return request.auth.token.get('role', ''); }
    function docRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', 'student');
    }

    // ── 옛 개인 폴더 (이미지 보안 5단계에서 닫음) ─────────────────
    // uploads/{userId}/{fileName}. 그림은 이제 반 폴더만 씁니다.
    //  · 쓰기: 전부 거부 — 앱에 이 폴더로 올리는 곳이 없습니다(수업 자료
    //          업로드 코드도 정리 커밋 cb4d752에서 걷혔습니다).
    //  · list: 거부 — 이 match가 uploads/{classId} 한 단계 목록에도 걸려
    //          반 폴더의 학생 uid가 드러나던 틈을 막습니다.
    //  · get : 로그인 사용자(저장된 파일이 없어 사실상 쓰이지 않음)
    //  · 지우기: 본인 또는 관리자(남은 파일 정리용)
    match /uploads/{userId}/{fileName} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if false;
      allow delete: if request.auth != null
                    && (request.auth.uid == userId || isAdmin());
    }

    // ── 반 폴더 (이미지 보안 2·4단계) ─────────────────────────────
    // uploads/{classId}/{userId}/{fileName} — 같은 반 학생·그 반 담당 교사·관리자만.
    // 판정은 firestore.rules의 isClassMember·ownsClass·isAdmin과 같습니다.
    //  · 반 소속 : memberships/{uid}_{classId} 문서가 있고, 반이 보관되지 않음
    //  · 담당 교사: 교사 역할 + classes/{classId}.createdBy == 내 uid
    //  · 관리자  : role == 'admin' (클레임 또는 users 문서)
    // 다른 반 교사는 볼 수 없습니다(정책). 목록 보기(list)와 덮어쓰기는 막습니다.
    function signedIn() { return request.auth != null; }
    function role() {
      return claimRole() != '' ? claimRole()
        : (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) ? docRole() : 'student');
    }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    function classDoc(classId) {
      return firestore.get(/databases/(default)/documents/classes/$(classId)).data;
    }
    function ownsClass(classId) {
      // 교사가 아니면 단락되어 classes 문서를 읽지 않습니다(학생 비용 없음)
      return signedIn() && (role() == 'teacher' || role() == 'admin')
             && classDoc(classId).get('createdBy', '') == request.auth.uid;
    }
    function isClassMember(classId) {
      return signedIn()
             && firestore.exists(/databases/(default)/documents/memberships/$(request.auth.uid + '_' + classId))
             && classDoc(classId).get('archived', false) != true;
    }

    match /uploads/{classId}/{userId}/{fileName} {
      allow get: if isClassMember(classId) || ownsClass(classId) || isAdmin();
      allow list: if false;
      // 새 파일만(덮어쓰기 금지) · 본인 폴더 · 그 반 소속(또는 담당 교사) · 이미지 6MB 미만
      allow create: if signedIn()
                    && resource == null   // 에뮬레이터 실측: 덮어쓰기도 create로 판정돼 명시합니다
                    && request.auth.uid == userId
                    && request.resource.contentType.matches('image/.*')
                    && request.resource.size < 6 * 1024 * 1024
                    // 4단계: 담당 교사도 그 반 폴더에 올립니다(메신저·공지에 붙인 그림)
                    && (isClassMember(classId) || ownsClass(classId));
      allow update: if false;
      allow delete: if signedIn() && (request.auth.uid == userId || ownsClass(classId) || isAdmin());
    }

    // 그 외 경로는 전부 거부 (기본 차단)
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
