rules_version = '2';

// =============================================================
// Firebase Storage 보안 규칙 — class-book-worksheets (책 나눔)
// -------------------------------------------------------------
// 첨부 이미지/파일 저장소. 경로: uploads/{uid}/{파일명}
//  · 읽기 : 로그인한 사용자 (교실 내 공유)
//  · 쓰기 : 본인 uid 폴더에만 + 용량/타입 제한
//  · 삭제 : 본인 또는 교사/관리자
//    (교사가 학생 게시물을 삭제할 때 첨부 파일도 함께 정리하려면
//     본인 아닌 파일도 지울 수 있어야 합니다. firestore.rules와 동일한
//     역할 판정 — role 커스텀 클레임 하나)
// 배포:  Firebase 콘솔 → Storage → 규칙 탭에 붙여넣고 게시
//        (또는 firebase deploy --only storage)
// =============================================================
service firebase.storage {
  match /b/{bucket}/o {

    function claimRole() { return request.auth.token.get('role', ''); }
    function docRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', 'student');
    }
    function isTeacher() {
      return request.auth != null && (
        claimRole() == 'teacher' || claimRole() == 'admin'
        || docRole() == 'teacher' || docRole() == 'admin'
      );
    }

    match /uploads/{userId}/{fileName} {
      // 로그인하면 읽기 가능 (다운로드 URL은 토큰 기반이라 공유 목적엔 충분)
      allow read: if request.auth != null;

      // 본인 폴더에만 업로드 + 용량/타입 제한.
      //  · 이미지  : 6MB
      //  · 문서    : 20MB — PDF·프레젠테이션·문서·엑셀. 수업 자료로 나눠 주는
      //              PDF와 PPTX는 1MB로는 어림도 없어 따로 칸을 뒀습니다.
      //  · 그 밖의 작은 파일: 1MB (텍스트/코드·CSV). 실행파일·영상·오디오 등 차단.
      //    (.py 등은 브라우저가 octet-stream으로 올리기도 해서 함께 허용)
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && (
                        (request.resource.contentType.matches('image/.*')
                          && request.resource.size < 6 * 1024 * 1024)
                        || (
                          request.resource.size < 20 * 1024 * 1024
                          && (
                            request.resource.contentType == 'application/pdf'
                            || request.resource.contentType == 'application/vnd.ms-excel'
                            || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
                            || request.resource.contentType == 'application/vnd.ms-powerpoint'
                            || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.presentationml.presentation'
                            || request.resource.contentType == 'application/msword'
                            || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
                          )
                        )
                        || (
                          request.resource.size < 1 * 1024 * 1024
                          && (
                            request.resource.contentType.matches('text/.*')
                            || request.resource.contentType == 'application/octet-stream'
                          )
                        )
                      );

      // 삭제는 본인 또는 교사/관리자(게시물 삭제 시 첨부 파일 정리 목적)
      allow delete: if request.auth != null && (request.auth.uid == userId || isTeacher());
    }

    // ── 반 폴더 (이미지 보안 2단계) ─────────────────────────────
    // uploads/{classId}/{userId}/{fileName} — 같은 반 학생·그 반 담당 교사·관리자만.
    // 판정은 firestore.rules의 isClassMember·ownsClass·isAdmin과 같습니다.
    //  · 반 소속 : memberships/{uid}_{classId} 문서가 있고, 반이 보관되지 않음
    //  · 담당 교사: 교사 역할 + classes/{classId}.createdBy == 내 uid
    //  · 관리자  : role == 'admin' (클레임 또는 users 문서)
    // 다른 반 교사는 볼 수 없습니다(정책). 목록 보기(list)와 덮어쓰기는 막습니다.
    function signedIn() { return request.auth != null; }
    function role() {
      return claimRole() != '' ? claimRole()
        : (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) ? docRole() : 'student');
    }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    function classDoc(classId) {
      return firestore.get(/databases/(default)/documents/classes/$(classId)).data;
    }
    function ownsClass(classId) {
      // 교사가 아니면 단락되어 classes 문서를 읽지 않습니다(학생 비용 없음)
      return signedIn() && (role() == 'teacher' || role() == 'admin')
             && classDoc(classId).get('createdBy', '') == request.auth.uid;
    }
    function isClassMember(classId) {
      return signedIn()
             && firestore.exists(/databases/(default)/documents/memberships/$(request.auth.uid + '_' + classId))
             && classDoc(classId).get('archived', false) != true;
    }

    match /uploads/{classId}/{userId}/{fileName} {
      allow get: if isClassMember(classId) || ownsClass(classId) || isAdmin();
      allow list: if false;
      // 새 파일만(덮어쓰기 금지) · 본인 폴더 · 그 반 소속 · 이미지 6MB 미만
      allow create: if signedIn()
                    && resource == null   // 에뮬레이터 실측: 덮어쓰기도 create로 판정돼 명시합니다
                    && request.auth.uid == userId
                    && request.resource.contentType.matches('image/.*')
                    && request.resource.size < 6 * 1024 * 1024
                    && isClassMember(classId);
      allow update: if false;
      allow delete: if signedIn() && (request.auth.uid == userId || ownsClass(classId) || isAdmin());
    }

    // 그 외 경로는 전부 거부 (기본 차단)
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
